---
// Where the buyer actually pays. Stripe hosted this page on its own domain; Payphone's
// Cajita is a widget, so it lives here — which is nicer for the buyer (they never leave the
// gallery) and puts three obligations on this file that a redirect would not have:
//
//   1. The Payphone token is rendered into the HTML, because the widget takes it as
//      configuration. It is domain-locked on Payphone's side. See getPayphoneConfig().
//   2. `Referrer-Policy` has to permit Payphone to see our origin, or the domain check
//      they rely on fails and the widget refuses to render.
//   3. A payment attempt must exist in our database BEFORE the widget can be shown, or a
//      buyer could complete a payment we have no way to resolve on the way back.
import { ObjectId } from 'mongodb';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { createStorage, getDbConfig, getDownloadConfig, getPayphoneConfig } from '../../../lib/config';
import { getDb } from '../../../lib/db';
import { getDictionary, type Locale } from '../../../lib/i18n';
import { canViewOrder, getOrderById } from '../../../lib/orders';
import { buildOrderThumbs } from '../../../lib/orderThumbs';
import { createPaymentAttempt } from '../../../lib/payments';
import { newClientTransactionId, PAYPHONE_FORM_LIFETIME_MS, splitAmountForIva } from '../../../lib/payphone';

export const prerender = false;

const lang = Astro.params.lang as Locale;
const t = getDictionary(lang);
const idParam = Astro.params.orderId as string;

let orderId: InstanceType<typeof ObjectId>;
try {
  orderId = new ObjectId(idParam);
} catch {
  return new Response('Not found', { status: 404 });
}

const db = await getDb(getDbConfig());
const order = await getOrderById(db, orderId);

if (!order) {
  return new Response('Not found', { status: 404 });
}

// 404 rather than 403, matching the order page: a 403 would confirm this order id exists.
// A guest order stays payable by anyone holding the (96-bit, unguessable) id, which is no
// wider than the existing exposure of /[lang]/order/[id] — and they would be paying *for*
// the order, not taking anything out of it.
const viewer = await Astro.session?.get('user');
if (!canViewOrder(order, viewer)) {
  return new Response('Not found', { status: 404 });
}

// One page shows order state; this one only takes money. Paid, cancelled, refunded and the
// impossible free-claim case all resolve the same way.
if (order.status !== 'pending') {
  return Astro.redirect(`/${lang}/order/${orderId.toString()}`, 302);
}

const amounts = splitAmountForIva(order.totalCents);
const clientTransactionId = newClientTransactionId(order._id.toString());

// Before render, deliberately: if this insert fails we must not put a widget in front of
// the buyer whose payment we could never resolve on the confirm leg.
await createPaymentAttempt(db, { orderId: order._id, clientTransactionId, amountCents: order.totalCents, lang });

// Payphone validates that the widget is running on the domain registered for the store,
// and that check reads the referrer. Set on this page rather than globally in middleware:
// it is one integration's requirement, and while most browsers already default to
// something that satisfies it, relying on a browser default for a payment gateway's
// security check is an accident rather than a decision.
Astro.response.headers.set('Referrer-Policy', 'origin-when-cross-origin');
Astro.response.headers.set('Cache-Control', 'no-store');

const payphone = getPayphoneConfig();
const money = (cents: number) => `$${(cents / 100).toFixed(2)}`;

// Thumbnails for the summary. Three filenames in a column told the buyer nothing about
// which photographs they had picked; a missing one degrades to no image (see
// lib/orderThumbs.ts) rather than breaking the page they are about to pay on.
const thumbs = await buildOrderThumbs(db, createStorage(), order);

// Shown as "3 fotografías × $1.75" only when every line really is the same price — with
// volume tiers they normally are, but a per-photo price override would make that sentence
// a lie, and then the line simply isn't drawn.
const unitPrices = new Set(order.items.map((item) => item.unitPriceCents));
const uniformUnitPrice = unitPrices.size === 1 ? [...unitPrices][0] : null;

const { ttlDays, maxUses } = getDownloadConfig();
const trustLinks = t.checkout.trustLinks.replace('{days}', String(ttlDays)).replace('{uses}', String(maxUses));

// A signed-in buyer already has an address on the order. A guest does not, and Payphone —
// unlike Stripe's hosted form — does not guarantee one comes back with the payment, so the
// widget stays locked until they give us one. The download links are the entire
// deliverable; sending them nowhere is not an acceptable outcome.
const knownEmail = order.customer.email || '';

const widgetConfig = {
  token: payphone.token,
  storeId: payphone.storeId,
  clientTransactionId,
  ...amounts,
  currency: 'USD',
  reference: `Fotografías — pedido ${order._id.toString().slice(-8)}`,
  lang,
  timeZone: -5,
  ...(knownEmail ? { email: knownEmail } : {}),
};
---

<BaseLayout title={`${t.checkout.title} — José Valdiviezo`} lang={lang}>
  <div
    class="mx-auto max-w-6xl px-6 py-10"
    data-checkout-page
    data-order-id={order._id.toString()}
    data-has-email={knownEmail ? 'true' : 'false'}
    data-expires-at={String(Date.now() + PAYPHONE_FORM_LIFETIME_MS)}
    data-pp-config={JSON.stringify(widgetConfig)}
    data-copy={JSON.stringify({
      loading: t.checkout.loading,
      expiresIn: t.checkout.expiresIn,
      expired: t.checkout.expired,
      WIDGET_UNAVAILABLE: t.checkout.errors.WIDGET_UNAVAILABLE,
      INVALID_EMAIL: t.checkout.errors.INVALID_EMAIL,
      UNKNOWN: t.checkout.errors.UNKNOWN,
    })}
  >
    {/* Three beats, two rules. The buyer arrives here from the cart with no idea whether
        this is the last screen — this says it is nearly over, and costs one row. */}
    <ol class="flex max-w-md items-center gap-3 text-[11px] uppercase tracking-widest text-ink-muted">
      <li class="flex items-center gap-2">
        <span class="inline-flex h-5 w-5 items-center justify-center rounded-full border border-ink bg-ink text-surface">
          <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12.5l4.5 4.5L19 7.5" />
          </svg>
        </span>
        {t.checkout.steps.cart}
      </li>
      <li class="h-px flex-1 bg-border" aria-hidden="true"></li>
      <li class="flex items-center gap-2 text-ink" aria-current="step">
        <span class="inline-flex h-5 w-5 items-center justify-center rounded-full border border-accent text-[10px] text-accent shadow-[0_0_0_3px_var(--color-accent-wash)]">2</span>
        {t.checkout.steps.payment}
      </li>
      <li class="h-px flex-1 bg-border" aria-hidden="true"></li>
      <li class="flex items-center gap-2">
        <span class="inline-flex h-5 w-5 items-center justify-center rounded-full border border-border-strong text-[10px]">3</span>
        {t.checkout.steps.downloads}
      </li>
    </ol>

    <h1 class="mt-5 font-display text-2xl">{t.checkout.title}</h1>

    {/*
      Two rails: paying on the left, what you're paying for on the right, which is the
      shape every buyer has already seen elsewhere. Both sections stay inside
      [data-checkout-page] — the script reaches all of its elements by querying down from
      that root, so the layout is free to move them around it but not out of it.

      The summary comes FIRST in the DOM and is placed into the right column explicitly,
      rather than being written second. Stacked on a phone that puts the order above the
      payment form, where it belongs; the usual objection to ordering columns this way
      (a keyboard tab order that jumps across the page) doesn't apply, because the
      summary holds nothing focusable except one link.
    */}
    <div class="mt-5 grid gap-7 md:grid-cols-[1.45fr_1fr]">
      <section class="panel p-4 md:sticky md:top-24 md:col-start-2 md:row-start-1 md:self-start">
        <div class="flex items-baseline justify-between gap-4">
          <h2 class="text-[11px] uppercase tracking-widest text-ink-muted">{t.checkout.orderSummary}</h2>
          <a href={`/${lang}/cart`} class="text-xs text-ink-muted underline transition-colors hover:text-ink">
            {t.checkout.summaryEdit}
          </a>
        </div>

        <ul class="mt-2 divide-y divide-border">
          {
            order.items.map((item) => {
              const thumb = thumbs[item.photoId.toString()];
              return (
                <li class="flex items-center gap-3 py-2.5">
                  {thumb ? (
                    <picture class="frame h-11 w-11 shrink-0 bg-border">
                      <source srcset={thumb.webpUrl} type="image/webp" />
                      <img src={thumb.jpegUrl} alt={item.photoTitle} class="h-full w-full object-cover" />
                    </picture>
                  ) : (
                    <span class="frame h-11 w-11 shrink-0 bg-border" aria-hidden="true" />
                  )}
                  <span class="min-w-0 flex-1">
                    <span class="block truncate text-sm">{item.photoTitle}</span>
                    <span class="block text-xs text-ink-muted">{t.cart.digitalFile}</span>
                  </span>
                  <span class="shrink-0 text-sm">{money(item.totalCents)}</span>
                </li>
              );
            })
          }
        </ul>

        {
          uniformUnitPrice !== null && order.items.length > 1 && (
            <p class="mt-3 flex justify-between text-xs text-ink-muted">
              <span>
                {order.items.length} × {money(uniformUnitPrice)}
              </span>
              <span>{money(order.subtotalCents)}</span>
            </p>
          )
        }

        <div class="mt-3 flex items-baseline justify-between border-t border-border-strong pt-3">
          <span class="font-display text-base">{t.checkout.total}</span>
          <span class="font-display text-xl">{money(order.totalCents)}</span>
        </div>

        <ul class="mt-4 grid gap-2 border-t border-border pt-3 text-xs text-ink-muted">
          <li class="flex items-center gap-2">
            <svg class="h-3.5 w-3.5 shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 3l7 3v6c0 4-3 7.2-7 9-4-1.8-7-5-7-9V6z" />
              <path d="M9 12l2 2 4-4" />
            </svg>
            {trustLinks}
          </li>
          <li class="flex items-center gap-2">
            <svg class="h-3.5 w-3.5 shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 7h16v12H4z" />
              <path d="M4 7l8 6 8-6" />
            </svg>
            {t.checkout.trustResend}
          </li>
        </ul>
      </section>

      <section class="md:col-start-1 md:row-start-1">
        <h2 class="text-[11px] uppercase tracking-widest text-ink-muted">{t.transfer.methodTitle}</h2>

        {/*
          Two methods, and the choice is expressed as a link rather than a tab or a radio
          group. Bank transfer lives on its own route — see the header of
          checkout/[orderId]/transfer.astro — so a buyer choosing it must actually leave
          this page, and pretending otherwise would only hide that the card panel below is
          already live and already holds a Payphone attempt.

          The selected state is drawn three ways (ring, filled radio, tinted panel): on a
          payment screen, "which one am I on" must never be a judgement call.
        */}
        <div class="mt-2 grid gap-2.5 sm:grid-cols-2">
          <div
            aria-current="true"
            class="panel border-accent bg-accent-wash p-3.5 shadow-[0_0_0_3px_var(--color-accent-wash)]"
          >
            <p class="flex items-center gap-2.5 text-sm">
              <span class="relative inline-flex h-4 w-4 shrink-0 items-center justify-center rounded-full border-[1.5px] border-accent">
                <span class="h-2 w-2 rounded-full bg-accent"></span>
              </span>
              <svg class="h-[18px] w-[18px] shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="2.5" y="5" width="19" height="14" rx="2.5" />
                <path d="M2.5 9.5h19" />
                <path d="M6 14.5h4" />
              </svg>
              {t.transfer.methodCard}
            </p>
            <p class="mt-1.5 pl-[26px] text-xs text-ink-muted">{t.transfer.methodCardHint}</p>
          </div>

          <a
            href={`/${lang}/checkout/${order._id.toString()}/transfer`}
            class="panel panel-interactive p-3.5 transition-transform hover:-translate-y-px"
          >
            <p class="flex items-center gap-2.5 text-sm">
              <span class="inline-flex h-4 w-4 shrink-0 rounded-full border-[1.5px] border-border-strong"></span>
              <svg class="h-[18px] w-[18px] shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3.5 9.5L12 4.5l8.5 5" />
                <path d="M5.5 9.5v8M9.5 9.5v8M14.5 9.5v8M18.5 9.5v8" />
                <path d="M3 19.5h18" />
              </svg>
              {t.transfer.methodTransfer}
            </p>
            <p class="mt-1.5 pl-[26px] text-xs text-ink-muted">{t.transfer.methodTransferHint}</p>
          </a>
        </div>

        {/* One panel for the whole card flow — the email gate used to be a separate box
            that vanished, which made the page jump and left the widget floating loose. */}
        <div class="panel mt-3 p-4">
          <div class="flex items-baseline justify-between gap-4">
            <h2 class="text-[11px] uppercase tracking-widest text-ink-muted">{t.checkout.paymentSection}</h2>
            <span class="flex items-center gap-1.5 text-xs text-ink-muted">
              <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="4.5" y="10" width="15" height="10" rx="2" />
                <path d="M8 10V7.5a4 4 0 0 1 8 0V10" />
              </svg>
              {t.checkout.securedBy}
            </span>
          </div>

          <div data-email-gate hidden={knownEmail !== ''} class="mt-3">
            <label class="block text-sm" for="checkout-email">{t.checkout.emailLabel}</label>
            <input id="checkout-email" data-email-input type="email" required autocomplete="email" class="field mt-1.5 w-full" />
            <p class="mt-2 text-xs text-ink-muted">{t.checkout.emailHint}</p>
            <button type="button" data-email-submit class="btn btn-primary mt-3 w-full py-3">
              {t.checkout.emailContinue}
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h13" />
                <path d="M13 6l6 6-6 6" />
              </svg>
            </button>
          </div>

          <p data-checkout-status hidden={knownEmail === ''} class="mt-3 text-sm text-ink-muted">{t.checkout.loading}</p>
          <p data-checkout-error hidden class="mt-3 text-sm text-accent"></p>

          <!-- The widget's required render target. -->
          <div id="pp-button" class="mt-3"></div>

          <div data-expired-panel hidden class="mt-3 rounded-md border border-border-strong p-3">
            <p class="text-sm text-ink-muted">{t.checkout.expired}</p>
            <!-- A reload is exactly right: it mints a fresh clientTransactionId and a fresh
                 attempt, which is what "start again" has to mean here. -->
            <button type="button" data-restart class="btn btn-primary mt-3 w-full py-3">{t.checkout.startAgain}</button>
          </div>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<link rel="stylesheet" href="https://cdn.payphonetodoesposible.com/box/v2.0/payphone-payment-box.css" />
<!-- is:inline so Astro leaves the remote module alone rather than trying to bundle it. -->
<script is:inline type="module" src="https://cdn.payphonetodoesposible.com/box/v2.0/payphone-payment-box.js"></script>

<script>
  import { actions } from 'astro:actions';

  document.addEventListener('astro:page-load', () => {
    const root = document.querySelector<HTMLElement>('[data-checkout-page]');
    if (!root || root.dataset.bound === 'true') return;
    root.dataset.bound = 'true';

    const copy = JSON.parse(root.dataset.copy!) as Record<string, string>;
    const config = JSON.parse(root.dataset.ppConfig!) as Record<string, unknown>;
    const expiresAt = Number(root.dataset.expiresAt);

    const gateEl = root.querySelector<HTMLElement>('[data-email-gate]')!;
    const emailInput = root.querySelector<HTMLInputElement>('[data-email-input]')!;
    const emailSubmit = root.querySelector<HTMLButtonElement>('[data-email-submit]')!;
    const statusEl = root.querySelector<HTMLElement>('[data-checkout-status]')!;
    const errorEl = root.querySelector<HTMLElement>('[data-checkout-error]')!;
    const boxEl = root.querySelector<HTMLElement>('#pp-button')!;
    const expiredEl = root.querySelector<HTMLElement>('[data-expired-panel]')!;
    const restartBtn = root.querySelector<HTMLButtonElement>('[data-restart]')!;

    function showError(message: string) {
      errorEl.textContent = message;
      errorEl.hidden = false;
    }

    /** Waits for the CDN module to define the global. It is a deferred remote script, so it
     *  may well not have evaluated by the time this runs. */
    async function waitForWidget(timeoutMs = 10_000): Promise<unknown> {
      const started = Date.now();
      while (Date.now() - started < timeoutMs) {
        const ctor = (window as unknown as { PPaymentButtonBox?: unknown }).PPaymentButtonBox;
        if (ctor) return ctor;
        await new Promise((resolve) => setTimeout(resolve, 100));
      }
      return null;
    }

    async function renderWidget() {
      statusEl.hidden = false;
      statusEl.textContent = copy.loading;

      const Ctor = (await waitForWidget()) as (new (c: unknown) => { render: (id: string) => void }) | null;
      if (!Ctor) {
        statusEl.hidden = true;
        return showError(copy.WIDGET_UNAVAILABLE);
      }

      try {
        new Ctor(config).render('pp-button');
        statusEl.hidden = true;
        startCountdown();
      } catch {
        statusEl.hidden = true;
        showError(copy.WIDGET_UNAVAILABLE);
      }
    }

    /** Counts down from the absolute expiry stamped into the page at render, NOT from ten
     *  minutes after this script runs. A back-button/bfcache restore re-runs the script but
     *  not the server render, so a relative timer would cheerfully show a fresh ten minutes
     *  over a form that died long ago. */
    function startCountdown() {
      const tick = () => {
        const remaining = expiresAt - Date.now();
        if (remaining <= 0) {
          statusEl.hidden = true;
          boxEl.hidden = true;
          expiredEl.hidden = false;
          clearInterval(timer);
          return;
        }
        const totalSeconds = Math.floor(remaining / 1000);
        const mmss = `${Math.floor(totalSeconds / 60)}:${String(totalSeconds % 60).padStart(2, '0')}`;
        statusEl.hidden = false;
        statusEl.textContent = copy.expiresIn.replace('{time}', mmss);
      };
      const timer = setInterval(tick, 1000);
      tick();
    }

    emailSubmit.addEventListener('click', async () => {
      const email = emailInput.value.trim();
      if (!email || !emailInput.checkValidity()) return showError(copy.INVALID_EMAIL);

      errorEl.hidden = true;
      emailSubmit.disabled = true;
      const { error } = await actions.setOrderEmail({ orderId: root.dataset.orderId!, email });
      if (error) {
        emailSubmit.disabled = false;
        return showError(copy[error.message] ?? copy.UNKNOWN);
      }

      // Payphone prefills the cardholder email from this, and — more importantly — the
      // address is now on the order, so the receipt has somewhere to go even if the
      // gateway's confirm response comes back without one.
      config.email = email;
      gateEl.hidden = true;
      void renderWidget();
    });

    restartBtn.addEventListener('click', () => location.reload());

    if (root.dataset.hasEmail === 'true') void renderWidget();
  });
</script>

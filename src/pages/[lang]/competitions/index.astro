---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { formatCompetitionDate, getCompetitionPhotoCounts, listPublishedCompetitions, resolveCoverPhoto } from '../../../lib/competitions';
import { createStorage, getDbConfig } from '../../../lib/config';
import { getDb } from '../../../lib/db';
import { getDictionary, type Locale } from '../../../lib/i18n';
import { getPhotoImageUrls } from '../../../lib/photos';

const lang = Astro.params.lang as Locale;
const t = getDictionary(lang);

const db = await getDb(getDbConfig());
const storage = createStorage();

const [competitions, counts] = await Promise.all([listPublishedCompetitions(db), getCompetitionPhotoCounts(db)]);

// Covers resolve through the shared helper (falling back to the first published photo)
// so this page and each competition page can never disagree about which image is theirs.
const allCards = await Promise.all(
  competitions.map(async (competition) => {
    const cover = await resolveCoverPhoto(db, competition);
    return {
      competition,
      urls: cover ? getPhotoImageUrls(cover, storage) : null,
      lqip: cover?.lqip ?? null,
      count: counts.get(competition._id.toString()) ?? 0,
      year: competition.date ? String(new Date(competition.date).getFullYear()) : null,
    };
  }),
);

/**
 * Year filter, server-side on `?year=`, in the same shape as the gallery's tag links.
 *
 * A third season makes this list long, and "which year" is the only question anyone asks
 * of it. Years are derived from the competitions themselves rather than configured, so
 * the filter can never offer a year with nothing behind it — and it disappears entirely
 * while there is only one.
 */
const years = [...new Set(allCards.map((card) => card.year).filter((year): year is string => year !== null))].sort(
  (a, b) => Number(b) - Number(a),
);
const activeYear = Astro.url.searchParams.get('year');
const cards = activeYear ? allCards.filter((card) => card.year === activeYear) : allCards;

const summary = t.competitions.summary
  .replace('{competitions}', String(cards.length))
  .replace('{photos}', String(cards.reduce((total, card) => total + card.count, 0)));

---

<BaseLayout title={`${t.competitions.title} — José Valdiviezo`} description={t.competitions.intro} lang={lang}>
  <div class="mx-auto max-w-7xl px-6 py-10 md:px-12">
    <h1 class="font-display text-3xl">{t.competitions.title}</h1>
    <p class="mt-2 max-w-prose text-sm text-ink-muted">{t.competitions.intro}</p>

    {
      years.length > 1 && (
        <div class="mt-5 flex flex-wrap items-center gap-2 text-xs uppercase tracking-widest">
          <a
            href={`/${lang}/competitions`}
            class={`chip py-1.5 ${!activeYear ? 'border-ink bg-ink text-surface' : 'text-ink-muted hover:text-ink'}`}
          >
            {t.competitions.allYears}
          </a>
          {years.map((year) => (
            <a
              href={`/${lang}/competitions?year=${year}`}
              class={`chip py-1.5 ${activeYear === year ? 'border-ink bg-ink text-surface' : 'text-ink-muted hover:text-ink'}`}
            >
              {year}
            </a>
          ))}
          <span class="ml-auto text-[11px] normal-case tracking-normal text-ink-muted">{summary}</span>
        </div>
      )
    }

    {cards.length === 0 && <p class="mt-12 text-ink-muted">{t.competitions.empty}</p>}

    {
      cards.length > 0 && (
        <ul class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {cards.map(({ competition, urls, lqip, count }) => (
            <li>
              <a href={`/${lang}/competitions/${competition.slug}`} class="group block transition-transform hover:-translate-y-0.5">
                <div class="frame relative aspect-[3/2] bg-border">
                  {lqip && <img src={lqip} alt="" aria-hidden="true" class="absolute inset-0 h-full w-full scale-105 object-cover blur-md" />}
                  {urls && (
                    <picture>
                      <source srcset={urls.webp} type="image/webp" />
                      <img
                        src={urls.jpeg}
                        alt={competition.name[lang]}
                        loading="lazy"
                        decoding="async"
                        class="relative h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]"
                      />
                    </picture>
                  )}
                  {/* The count rides on the cover, on hover: it answers "is my race in
                      here" without pushing another line under every card. */}
                  <span class="pointer-events-none absolute bottom-2.5 left-2.5 translate-y-1 rounded-full bg-ink/70 px-2.5 py-1 text-[11px] tracking-normal text-surface opacity-0 backdrop-blur-sm transition-all duration-200 group-hover:translate-y-0 group-hover:opacity-100">
                    {t.competitions.photoCount.replace('{count}', String(count))}
                  </span>
                </div>
                <h2 class="mt-2.5 font-display text-lg">{competition.name[lang]}</h2>
                <p class="mt-0.5 text-sm text-ink-muted">
                  {formatCompetitionDate(competition.date, lang)}
                  {competition.location && ` · ${competition.location}`}
                </p>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</BaseLayout>

---
import BuyPanel from '../../../components/BuyPanel.astro';
import Lightbox from '../../../components/Lightbox.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCompetitionById } from '../../../lib/competitions';
import { createStorage, getDbConfig } from '../../../lib/config';
import { getDb } from '../../../lib/db';
import { getDictionary, type Locale } from '../../../lib/i18n';
import type { OrderDoc } from '../../../lib/orders';
import { getPhotoBySlug, getPhotoImageUrls } from '../../../lib/photos';
import { findActiveUserById } from '../../../lib/users';
import { getSettings } from '../../../lib/settings';

const lang = Astro.params.lang as Locale;
const slug = Astro.params.slug as string;
const t = getDictionary(lang);

const db = await getDb(getDbConfig());
const photo = await getPhotoBySlug(db, slug);

if (!photo) {
  Astro.response.status = 404;
}

let title = '';
let description = '';
let urls: { webp: string; jpeg: string } | null = null;
let settings: Awaited<ReturnType<typeof getSettings>> | null = null;
let digitalPriceCents = 0;
let jsonLd: Record<string, unknown> | null = null;
let competition: Awaited<ReturnType<typeof getCompetitionById>> = null;

// The credit balance is read from the user document, never from the session — the session
// is a snapshot taken at sign-in and would show a stale count after a claim in another tab.
let freeDownloadsRemaining: number | undefined;
let ownedOrderId: string | undefined;
let alreadyClaimed = false;

if (photo) {
  const sessionUser = await Astro.session?.get('user');
  if (sessionUser) {
    const viewer = await findActiveUserById(db, sessionUser.id);
    if (viewer) {
      freeDownloadsRemaining = viewer.freeDownloadsRemaining;
      // Anything this account already owns — bought or claimed — offers a fresh download
      // instead of selling the same file twice.
      const owned = await db
        .collection<OrderDoc>('orders')
        .findOne({ userId: viewer._id, status: 'paid', 'items.photoId': photo._id }, { sort: { createdAt: -1 } });
      if (owned) {
        ownedOrderId = owned._id.toString();
        alreadyClaimed = owned.kind === 'free-claim';
      }
    }
  }

  if (photo.competitionId) competition = await getCompetitionById(db, photo.competitionId);
  settings = await getSettings(db);
  const storage = createStorage();
  urls = getPhotoImageUrls(photo, storage);
  title = photo.title[lang];
  description = photo.description[lang];
  digitalPriceCents = photo.pricing?.digitalPriceCents ?? settings.digitalPriceCents;
  jsonLd = {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: title,
    description,
    image: urls.jpeg,
    brand: { '@type': 'Person', name: 'José Valdiviezo' },
    // A plain Offer, not AggregateOffer: there's exactly one price now that sizes and
    // paper stocks are gone, and `lowPrice` with no `highPrice` described a range that
    // never existed. Volume discounts deliberately aren't modelled here — they're a
    // property of a whole cart, not of this photograph.
    offers: {
      '@type': 'Offer',
      priceCurrency: 'USD',
      price: (digitalPriceCents / 100).toFixed(2),
      availability: 'https://schema.org/InStock',
      itemCondition: 'https://schema.org/NewCondition',
    },
  };
}
---

<BaseLayout
  title={photo ? `${title} — José Valdiviezo` : `${t.notFound.photoTitle} — José Valdiviezo`}
  description={photo ? description : undefined}
  lang={lang}
  ogImage={photo ? urls!.jpeg : undefined}
>
  {jsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />}

  {
    !photo && (
      <div class="mx-auto max-w-lg px-6 py-24 text-center">
        <h1 class="font-display text-3xl">{t.notFound.photoTitle}</h1>
        <p class="mt-4 text-ink-muted">{t.notFound.photoBody}</p>
        <a href={`/${lang}/gallery`} class="mt-8 inline-block text-sm uppercase tracking-widest text-accent hover:underline">
          &larr; {t.detail.back}
        </a>
      </div>
    )
  }

  {
    photo && settings && urls && (
      <div class="mx-auto max-w-6xl px-4 py-8 md:px-8">
        <a href={`/${lang}/gallery`} class="text-xs uppercase tracking-widest text-ink-muted hover:text-ink">
          &larr; {t.detail.back}
        </a>

        {/* Photograph beside its details rather than stacked above them. The right column
            sticks so the price and download control stay in view next to a tall image
            instead of scrolling away from it. */}
        <div class="mt-6 grid gap-10 md:grid-cols-[1.35fr_1fr]">
          <div>
            <Lightbox
              slug={photo.slug}
              title={title}
              webpUrl={urls.webp}
              jpegUrl={urls.jpeg}
              aspectRatio={photo.aspectRatio}
              lqip={photo.lqip}
            />
          </div>

          <div class="md:sticky md:top-8 md:self-start">
            <h1 class="font-display text-2xl md:text-3xl">{title}</h1>
            {description && <p class="mt-4 text-ink-muted leading-relaxed">{description}</p>}

            {/* Routes on the competition's generated ASCII slug, not its display name —
                which is also what retires the unencoded-href bug the old free-text
                collections had, since every real event name has spaces and accents. */}
            {competition && (
              <p class="mt-6">
                <a
                  href={`/${lang}/competitions/${competition.slug}`}
                  class="chip border-ink bg-ink uppercase tracking-widest text-surface hover:opacity-80"
                >
                  {competition.name[lang]}
                </a>
              </p>
            )}

            {photo.tags.length > 0 && (
              <ul class="mt-3 flex flex-wrap gap-2 text-xs uppercase tracking-widest text-ink-muted">
                {photo.tags.map((tag) => (
                  <li class="chip">{tag}</li>
                ))}
              </ul>
            )}

            <dl class="mt-8 grid grid-cols-2 gap-x-6 gap-y-2 text-sm text-ink-muted sm:max-w-sm">
              {photo.capture.camera && (
                <>
                  <dt class="text-ink-muted/70">{t.detail.specs.camera}</dt>
                  <dd>{photo.capture.camera}</dd>
                </>
              )}
              {photo.capture.lens && (
                <>
                  <dt class="text-ink-muted/70">{t.detail.specs.lens}</dt>
                  <dd>{photo.capture.lens}</dd>
                </>
              )}
              {photo.capture.iso && (
                <>
                  <dt class="text-ink-muted/70">{t.detail.specs.iso}</dt>
                  <dd>{photo.capture.iso}</dd>
                </>
              )}
              {photo.capture.aperture && (
                <>
                  <dt class="text-ink-muted/70">{t.detail.specs.aperture}</dt>
                  <dd>{photo.capture.aperture}</dd>
                </>
              )}
              {photo.capture.shutter && (
                <>
                  <dt class="text-ink-muted/70">{t.detail.specs.shutter}</dt>
                  <dd>{photo.capture.shutter}</dd>
                </>
              )}
              {photo.capture.location && (
                <>
                  <dt class="text-ink-muted/70">{t.detail.specs.location}</dt>
                  <dd>{photo.capture.location}</dd>
                </>
              )}
            </dl>

            <div class="mt-8 border-t border-border pt-6">
              <BuyPanel
                photoId={photo._id.toString()}
                digitalPriceCents={digitalPriceCents}
                t={t}
                lang={lang}
                freeDownloadsRemaining={freeDownloadsRemaining}
                alreadyClaimed={alreadyClaimed}
                ownedOrderId={ownedOrderId}
              />
            </div>
          </div>
        </div>
      </div>
    )
  }
</BaseLayout>

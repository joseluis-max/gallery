---
import MosaicGrid, { type GridItem } from '../../../components/MosaicGrid.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { createStorage, getDbConfig } from '../../../lib/config';
import { getDb } from '../../../lib/db';
import { getDictionary, type Locale } from '../../../lib/i18n';
import { getAllTags, getPhotoImageUrls, getPublishedPhotos } from '../../../lib/photos';

const lang = Astro.params.lang as Locale;
const t = getDictionary(lang);

const activeTag = Astro.url.searchParams.get('tag') ?? undefined;

const db = await getDb(getDbConfig());
const storage = createStorage();
const [photos, tags] = await Promise.all([getPublishedPhotos(db, { tag: activeTag }), getAllTags(db)]);

const cart = (await Astro.session?.get('cart')) ?? [];
const cartLineByPhotoId = new Map(cart.map((item) => [item.photoId, item.lineId]));

const items: GridItem[] = photos.map((photo) => {
  const urls = getPhotoImageUrls(photo, storage);
  const photoId = photo._id.toString();
  return {
    href: `/${lang}/gallery/${photo.slug}`,
    slug: photo.slug,
    title: photo.title[lang],
    aspectRatio: photo.aspectRatio,
    lqip: photo.lqip,
    webpUrl: urls.webp,
    jpegUrl: urls.jpeg,
    photoId,
    inCart: cartLineByPhotoId.has(photoId),
    lineId: cartLineByPhotoId.get(photoId),
  };
});
---

<BaseLayout title={`${t.gallery.title} — José Valdiviezo`} description={t.about.body} lang={lang}>
  <div class="px-6 pb-5 pt-9 md:px-12" data-gallery data-no-results={t.gallery.searchNoResults}>
    <div class="flex flex-wrap items-end justify-between gap-4">
      <h1 class="font-display text-3xl">{t.gallery.title}</h1>

      {/*
        Filters narrow by *subject*; this narrows by name, which is what somebody looking
        for one frame out of three hundred actually has. Client-side on purpose: every
        published photograph is already in this document, so filtering is instant and
        needs no round trip — and with JavaScript off the field simply isn't there while
        the tag links keep working.
      */}
      <label class="inline-flex min-w-[16rem] items-center gap-2 rounded-full border border-border-strong px-3.5 py-2 transition-colors focus-within:border-accent">
        <svg class="h-4 w-4 shrink-0 text-ink-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="6.5" />
          <path d="M16 16l4 4" />
        </svg>
        <input
          data-gallery-search
          type="search"
          placeholder={t.gallery.searchPlaceholder}
          aria-label={t.gallery.searchPlaceholder}
          class="w-full border-0 bg-transparent p-0 text-sm outline-none placeholder:text-ink-muted/70"
        />
      </label>
    </div>

    <nav class="mt-5 flex flex-wrap gap-2 text-xs uppercase tracking-widest" aria-label="Filter by tag">
      <a
        href={`/${lang}/gallery`}
        class={`chip py-1.5 ${!activeTag ? 'border-ink bg-ink text-surface' : 'text-ink-muted hover:text-ink'}`}
      >
        {t.gallery.allTags}
      </a>
      {
        tags.map((tag) => (
          <a
            href={`/${lang}/gallery?tag=${encodeURIComponent(tag)}`}
            class={`chip py-1.5 ${activeTag === tag ? 'border-ink bg-ink text-surface' : 'text-ink-muted hover:text-ink'}`}
          >
            {tag}
          </a>
        ))
      }
    </nav>
  </div>

  <div class="px-2 pb-20 md:px-6">
    {
      items.length > 0 ? (
        <MosaicGrid items={items} addToCartLabel={t.gallery.addToCart} removeFromCartLabel={t.gallery.removeFromCart} />
      ) : (
        <p class="px-4 text-ink-muted">{t.gallery.empty}</p>
      )
    }
    <p data-gallery-empty hidden class="px-4 py-10 text-center text-sm text-ink-muted"></p>
  </div>
</BaseLayout>

<script>
  document.addEventListener('astro:page-load', () => {
    const root = document.querySelector<HTMLElement>('[data-gallery]');
    const input = root?.querySelector<HTMLInputElement>('[data-gallery-search]');
    if (!root || !input || input.dataset.bound === 'true') return;
    input.dataset.bound = 'true';

    const emptyEl = document.querySelector<HTMLElement>('[data-gallery-empty]')!;
    const tiles = Array.from(document.querySelectorAll<HTMLElement>('[data-photo-title]'));

    input.addEventListener('input', () => {
      const needle = input.value.trim().toLowerCase();
      let shown = 0;

      for (const tile of tiles) {
        // `hidden` rather than display:none — the tile carries grid-span utility classes,
        // and the dense grid re-packs around whatever is left without a layout pass.
        const match = !needle || tile.dataset.photoTitle!.includes(needle);
        tile.hidden = !match;
        if (match) shown++;
      }

      emptyEl.textContent = root.dataset.noResults!;
      emptyEl.hidden = shown > 0 || tiles.length === 0;
    });
  });
</script>

---
import { ObjectId } from 'mongodb';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getDbConfig } from '../../../lib/config';
import { getDb } from '../../../lib/db';
import { getDictionary, type Locale } from '../../../lib/i18n';
import { listOrdersForUser } from '../../../lib/orders';
import { findActiveUserById, MIN_PASSWORD_LENGTH } from '../../../lib/users';

const lang = Astro.params.lang as Locale;
const t = getDictionary(lang);

const sessionUser = await Astro.session?.get('user');
if (!sessionUser) {
  return Astro.redirect(`/${lang}/account/login?next=${encodeURIComponent(`/${lang}/account`)}`);
}

const db = await getDb(getDbConfig());
// Guest orders placed with the same address deliberately don't appear here — see the
// `userId` comment in lib/orders.ts.
const orders = await listOrdersForUser(db, new ObjectId(sessionUser.id));

// Read from the database, never from the session: the cookie is a sign-in snapshot, and a
// credit spent in another tab would leave this page advertising a balance that is gone.
const account = await findActiveUserById(db, sessionUser.id);
const freeRemaining = account?.freeDownloadsRemaining ?? 0;

function fmt(cents: number): string {
  return `$${(cents / 100).toFixed(2)}`;
}
---

<BaseLayout title={`${t.account.accountTitle} — José Valdiviezo`} lang={lang}>
  <div
    class="mx-auto max-w-3xl px-6 py-10"
    data-account-page
    data-lang={lang}
    data-errors={JSON.stringify(t.account.errors)}
    data-success={JSON.stringify({ profile: t.account.savedProfile, password: t.account.savedPassword })}
  >
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center gap-3">
        <span class="inline-flex h-11 w-11 items-center justify-center rounded-full bg-accent-wash text-accent">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="8" r="3.2" />
            <path d="M5 20c1.2-3.4 3.9-5 7-5s5.8 1.6 7 5" />
          </svg>
        </span>
        <div>
          <h1 class="font-display text-2xl">{sessionUser.name || t.account.accountTitle}</h1>
          <p class="text-sm text-ink-muted">{sessionUser.email}</p>
        </div>
      </div>
      <button type="button" data-logout class="btn btn-ghost">
        <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M14 5V4a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2v-1" />
          <path d="M10 12h11" />
          <path d="M18 9l3 3-3 3" />
        </svg>
        {t.account.signOut}
      </button>
    </div>

    {
      sessionUser.role === 'admin' && (
        <a href="/admin" class="panel panel-interactive mt-5 inline-block px-4 py-2 text-sm">
          {lang === 'es' ? 'Ir al panel de administración' : 'Go to the admin panel'} →
        </a>
      )
    }

    {/* The free-credit balance, out of the photo page and onto the one screen an account
        holder actually revisits — a balance nobody can see is a balance nobody spends. */}
    <div class={`panel mt-5 flex flex-wrap items-center justify-between gap-4 p-4 ${freeRemaining > 0 ? 'border-accent/30 bg-accent-wash' : ''}`}>
      <span class="flex items-center gap-3">
        <svg class={`h-5 w-5 shrink-0 ${freeRemaining > 0 ? 'text-accent' : 'text-ink-muted'}`} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 3l2.4 5.3 5.6.6-4.2 3.9 1.2 5.7L12 15.8 6.9 18.5l1.2-5.7L4 8.9l5.6-.6z" />
        </svg>
        <span>
          <span class="block text-sm">
            {freeRemaining > 0 ? t.account.freeBalance.replace('{count}', String(freeRemaining)) : t.account.freeBalanceSpent}
          </span>
          {freeRemaining > 0 && <span class="block text-xs text-ink-muted">{t.account.freeBalanceHint}</span>}
        </span>
      </span>
      {freeRemaining > 0 && (
        <a href={`/${lang}/gallery`} class="btn btn-primary">{t.account.chooseFree}</a>
      )}
    </div>

    <section class="mt-8">
      <h2 class="text-[11px] uppercase tracking-widest text-ink-muted">{t.account.orders}</h2>

      {orders.length === 0 && <p class="panel mt-2 p-8 text-center text-sm text-ink-muted">{t.account.noOrders}</p>}

      {
        orders.length > 0 && (
          <ul class="panel mt-2 divide-y divide-border px-4">
            {orders.map((order) => (
              <li class="flex flex-wrap items-center gap-x-4 gap-y-2 py-3">
                <span class="font-mono text-sm">#{order._id.toString().slice(-8)}</span>
                <span class="text-xs text-ink-muted">{new Date(order.createdAt).toLocaleDateString(lang)}</span>
                <span class={`status-pill ${order.status === 'paid' ? 'status-pill-done' : ''}`}>
                  {t.account.statuses[order.status]}
                </span>
                <span class="ml-auto text-sm">{fmt(order.totalCents)}</span>
                <a
                  href={`/${lang}/order/${order._id.toString()}`}
                  class="btn btn-ghost px-3.5 py-1.5 text-[11px]"
                >
                  {order.status === 'paid' ? t.order.download : t.account.viewOrder}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </section>

    <section class="mt-8">
      <h2 class="text-[11px] uppercase tracking-widest text-ink-muted">{t.account.profile}</h2>
      <form data-profile-form class="panel mt-2 space-y-3.5 p-4">
        <label class="block text-sm">
          {t.account.name}
          <input
            type="text"
            name="name"
            value={sessionUser.name}
            autocomplete="name"
            required
            class="field mt-1 block w-full px-3 py-2"
          />
        </label>
        <label class="block text-sm">
          {t.account.email}
          <input
            type="email"
            name="email"
            value={sessionUser.email}
            autocomplete="email"
            required
            class="field mt-1 block w-full px-3 py-2"
          />
        </label>
        <p data-profile-message hidden class="text-sm"></p>
        <button type="submit" class="btn btn-ghost">
          {t.account.saveProfile}
        </button>
      </form>
    </section>

    <section class="mt-8">
      <h2 class="text-[11px] uppercase tracking-widest text-ink-muted">{t.account.changePassword}</h2>
      <form data-password-form class="panel mt-2 space-y-3.5 p-4">
        <label class="block text-sm">
          {t.account.currentPassword}
          <input
            type="password"
            name="currentPassword"
            autocomplete="current-password"
            required
            class="field mt-1 block w-full px-3 py-2"
          />
        </label>
        <label class="block text-sm">
          {t.account.newPassword}
          <input
            type="password"
            name="newPassword"
            autocomplete="new-password"
            required
            minlength={MIN_PASSWORD_LENGTH}
            class="field mt-1 block w-full px-3 py-2"
          />
          <span class="mt-1 block text-xs text-ink-muted">{t.account.passwordHint}</span>
        </label>
        <p data-password-message hidden class="text-sm"></p>
        <button type="submit" class="btn btn-ghost">
          {t.account.changePassword}
        </button>
      </form>
    </section>
  </div>
</BaseLayout>

<script>
  import { actions } from 'astro:actions';

  document.addEventListener('astro:page-load', () => {
    const root = document.querySelector<HTMLElement>('[data-account-page]');
    if (!root || root.dataset.bound === 'true') return;
    root.dataset.bound = 'true';

    const lang = root.dataset.lang!;
    const messages: Record<string, string> = JSON.parse(root.dataset.errors!);
    const successText: { profile: string; password: string } = JSON.parse(root.dataset.success!);

    function show(el: HTMLElement, text: string, ok: boolean) {
      el.textContent = text;
      el.className = ok ? 'text-sm text-ink-muted' : 'text-sm text-accent';
      el.hidden = false;
    }

    const profileForm = root.querySelector<HTMLFormElement>('[data-profile-form]')!;
    const profileMessage = root.querySelector<HTMLElement>('[data-profile-message]')!;
    profileForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      const value = (name: string) => (profileForm.elements.namedItem(name) as HTMLInputElement).value;
      const { error } = await actions.auth.updateProfile({ name: value('name'), email: value('email') });
      show(profileMessage, error ? (messages[error.message] ?? messages.UNKNOWN) : successText.profile, !error);
    });

    const passwordForm = root.querySelector<HTMLFormElement>('[data-password-form]')!;
    const passwordMessage = root.querySelector<HTMLElement>('[data-password-message]')!;
    passwordForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      const value = (name: string) => (passwordForm.elements.namedItem(name) as HTMLInputElement).value;
      const { error } = await actions.auth.changePassword({
        currentPassword: value('currentPassword'),
        newPassword: value('newPassword'),
      });
      show(passwordMessage, error ? (messages[error.message] ?? messages.UNKNOWN) : successText.password, !error);
      if (!error) passwordForm.reset();
    });

    root.querySelector<HTMLButtonElement>('[data-logout]')?.addEventListener('click', async () => {
      await actions.auth.logout({});
      window.location.href = `/${lang}/`;
    });
  });
</script>

---
import AuthLayout from '../../../components/AuthLayout.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getDictionary, type Locale } from '../../../lib/i18n';
import { safeRedirectTarget } from '../../../lib/redirects';

const lang = Astro.params.lang as Locale;
const t = getDictionary(lang);

// `?next=` survives the sign-in round trip so a visitor bounced off /account (or any
// other guarded page) lands back where they were headed. Filtered through
// safeRedirectTarget so a crafted `?next=https://evil.example` can't turn this form
// into an open redirect.
const next = safeRedirectTarget(Astro.url.searchParams.get('next'), `/${lang}/account`);

// Set by the reset page, which sends people here rather than signing them in on the
// strength of an email link. Purely cosmetic — a crafted `?reset=done` shows a banner and
// nothing else, since it grants nothing and asserts nothing about the visitor.
const justReset = Astro.url.searchParams.get('reset') === 'done';

const sessionUser = await Astro.session?.get('user');
if (sessionUser) {
  return Astro.redirect(sessionUser.role === 'admin' ? '/admin' : next);
}
---

<BaseLayout title={`${t.account.signInTitle} — José Valdiviezo`} lang={lang}>
  {/* The data-* hooks stay on the wrapper the script queries — AuthLayout only supplies
      the two-column shell around this form. */}
  <div data-auth-page data-next={next} data-errors={JSON.stringify(t.account.errors)}>
    <AuthLayout lang={lang} mode="signin" next={next}>
      <h1 class="font-display text-2xl">{t.account.signInTitle}</h1>

      {
        justReset && (
          <p class="mt-4 flex items-start gap-2.5 rounded-md bg-accent-wash p-3 text-sm">
            <svg class="mt-0.5 h-4 w-4 shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="9" />
              <path d="M8.5 12.5l2.5 2.5 4.5-5" />
            </svg>
            {t.account.resetDone}
          </p>
        )
      }

      <form data-login-form class="mt-5 space-y-3.5">
        <label class="block text-sm">
          {t.account.email}
          <input type="email" name="email" autocomplete="email" required class="field mt-1 block w-full px-3 py-2" />
        </label>
        <label class="block text-sm">
          {/* The label and the recovery link share the password row rather than the link
              sitting under the button: the moment somebody needs it is the moment they're
              looking at this field, having just failed to fill it. */}
          <span class="flex items-baseline justify-between gap-3">
            {t.account.password}
            <a
              href={`/${lang}/account/forgot?next=${encodeURIComponent(next)}`}
              class="text-xs text-ink-muted underline hover:text-ink"
            >
              {t.account.forgotLink}
            </a>
          </span>
          <input
            type="password"
            name="password"
            autocomplete="current-password"
            required
            class="field mt-1 block w-full px-3 py-2"
          />
        </label>
        <p data-auth-error hidden class="text-sm text-accent"></p>
        <button type="submit" class="btn btn-primary w-full py-3">{t.account.signIn}</button>
      </form>

      <p class="mt-4 text-sm text-ink-muted">
        {t.account.noAccount}{' '}
        <a href={`/${lang}/account/register?next=${encodeURIComponent(next)}`} class="underline hover:text-ink">
          {t.account.createOne}
        </a>
      </p>
    </AuthLayout>
  </div>
</BaseLayout>

<script>
  import { actions } from 'astro:actions';

  document.addEventListener('astro:page-load', () => {
    const root = document.querySelector<HTMLElement>('[data-auth-page]');
    const form = root?.querySelector<HTMLFormElement>('[data-login-form]');
    if (!root || !form || root.dataset.bound === 'true') return;
    root.dataset.bound = 'true';

    const errorEl = root.querySelector<HTMLElement>('[data-auth-error]')!;
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const messages: Record<string, string> = JSON.parse(root.dataset.errors!);

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      errorEl.hidden = true;
      submit.disabled = true;

      const email = (form.elements.namedItem('email') as HTMLInputElement).value;
      const password = (form.elements.namedItem('password') as HTMLInputElement).value;
      const { data, error } = await actions.auth.login({ email, password });

      if (error || !data) {
        errorEl.textContent = messages[error?.message ?? ''] ?? messages.UNKNOWN;
        errorEl.hidden = false;
        submit.disabled = false;
        return;
      }

      // Full page load, not a client-side navigation: every page reads the session
      // server-side, so the new signed-in state has to come from the server.
      window.location.href = data.user.role === 'admin' ? '/admin' : root.dataset.next!;
    });
  });
</script>

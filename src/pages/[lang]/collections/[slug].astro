---
import type { Locale } from '../../../lib/i18n';

// `/collections/<name>` was the old free-text grouping, replaced by competitions (real
// documents, at /competitions/<slug>) and the portfolio (everything not shot at an
// event). Every collection that existed here — "galapagos" — is portfolio work now, so
// that's where these URLs point. Permanent, because the old route is never coming back.
const lang = Astro.params.lang as Locale;
return Astro.redirect(`/${lang}/portfolio`, 301);
---

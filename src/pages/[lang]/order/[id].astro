---
import { ObjectId } from 'mongodb';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { findLatestTransferForOrder } from '../../../lib/bankTransfer';
import { createStorage, getDbConfig, getDownloadConfig } from '../../../lib/config';
import { getDb } from '../../../lib/db';
import { getDictionary, type Locale } from '../../../lib/i18n';
import { canViewOrder, getOrderById } from '../../../lib/orders';
import { buildOrderThumbs } from '../../../lib/orderThumbs';

const lang = Astro.params.lang as Locale;
const t = getDictionary(lang);
const idParam = Astro.params.id as string;

let orderId: InstanceType<typeof ObjectId>;
try {
  orderId = new ObjectId(idParam);
} catch {
  return new Response('Not found', { status: 404 });
}

// Deliberately reads order status from Mongo, never from the redirect that brought the
// buyer here. That mattered under Stripe and it matters more under Payphone: the return
// leg carries `id` and `clientTransactionId` in a query string anyone can type, and the
// only authoritative statement about a payment is the confirm response the server pulled
// back itself (see api/payphone-confirm.ts).
const db = await getDb(getDbConfig());
const order = await getOrderById(db, orderId);

if (!order) {
  return new Response('Not found', { status: 404 });
}

// 404 rather than 403 for someone else's order — a 403 would confirm that this exact
// order id exists.
const viewer = await Astro.session?.get('user');
if (!canViewOrder(order, viewer)) {
  return new Response('Not found', { status: 404 });
}

const digitalItemCount = order.items.length;

// The download links are deliberately NOT the tokens fulfilment emailed. Only a token's
// hash is stored (lib/downloads.ts), so those raw values no longer exist anywhere on the
// server — and minting a fresh set on every render would spend a token row on every
// refresh, back-button and crawl. Each link below points at an endpoint that mints one
// when it is actually clicked; see api/order-download/[orderId]/[photoId].ts, which
// re-checks `canViewOrder` so this page can never hand out more than it is allowed to.
const { ttlDays, maxUses } = getDownloadConfig();

const downloadsValidity = t.order.downloadsValidity.replace('{days}', String(ttlDays)).replace('{uses}', String(maxUses));

/**
 * Masks the local part of the address the receipt went to.
 *
 * A guest order is readable by anyone holding its id — that is the documented deal in
 * lib/orders.ts — and a receipt link is exactly the kind of thing that gets forwarded, so
 * printing the address in full would publish it to everyone downstream. The masked form
 * still does the job it is here for: the buyer recognises their own address, and a
 * mistyped *domain* — the error that actually strands a purchase — stays visible.
 */
function maskEmail(address: string): string {
  const at = address.lastIndexOf('@');
  if (at <= 0) return '•••';
  return `${address[0]}•••${address.slice(at)}`;
}

const emailNotice = order.customer.email
  ? t.order.emailedTo.replace('{count}', String(digitalItemCount)).replace('{email}', maskEmail(order.customer.email))
  : t.order.noEmail;

// Reading `?payment=` is safe precisely because it only picks which *message* to show —
// the order's actual status still comes from the database above. Anyone can put
// `?payment=declined` on this URL and all they get is a sentence.
const paymentParam = Astro.url.searchParams.get('payment');
const paymentNotice = paymentParam === 'declined' ? t.order.declined : paymentParam === 'unconfirmed' ? t.order.unconfirmed : null;

// A bank transfer leaves an order pending for hours while a person looks at a screenshot,
// which is a state the Payphone-only version of this page had no way to express: "we're
// waiting on payment confirmation" is misleading when the truth is "we have your receipt".
// Only read for a pending order — once it is paid, how it was paid is on `order.payment`
// and this query would answer a question nobody asked.
const latestTransfer = order.status === 'pending' ? await findLatestTransferForOrder(db, order._id) : null;
const transferInReview = latestTransfer?.status === 'in-review';
const transferRejected = latestTransfer?.status === 'rejected';

const thumbs = await buildOrderThumbs(db, createStorage(), order);

const dateFmt = new Intl.DateTimeFormat(lang, { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' });

/**
 * The three beats of an order, derived from what actually happened rather than stored.
 *
 * A card payment passes all three within seconds and this reads as a receipt; a transfer
 * sits on beat two for hours, which is the case the trail exists for — "we have your
 * receipt, nobody has looked at it yet" is a different thing from "waiting for payment",
 * and the page had no way to say either before.
 */
const paidAt = order.history.find((entry) => entry.status === 'paid')?.at;
const tracking = [
  { title: t.order.tracking.created, meta: dateFmt.format(new Date(order.createdAt)), done: true, now: false },
  {
    title: latestTransfer ? t.order.tracking.receiptUploaded : t.order.tracking.awaitingPayment,
    meta: latestTransfer ? dateFmt.format(new Date(latestTransfer.submittedAt)) : t.order.tracking.noReceiptYet,
    done: Boolean(latestTransfer) || order.status === 'paid',
    now: transferInReview,
  },
  {
    title: transferRejected ? t.order.tracking.rejected : t.order.tracking.released,
    meta: paidAt ? dateFmt.format(new Date(paidAt)) : t.order.tracking.pendingRelease,
    done: order.status === 'paid',
    now: transferRejected,
  },
];

const paymentMethodLabel =
  order.payment?.method === 'transfer' ? t.order.methodTransfer : order.payment ? t.order.methodCard : null;
---

<BaseLayout title={`${lang === 'es' ? 'Pedido' : 'Order'} #${order._id.toString()} — José Valdiviezo`} lang={lang}>
  <div class="mx-auto max-w-3xl px-6 py-10">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <div>
        <p class="text-[10px] uppercase tracking-widest text-ink-muted">{lang === 'es' ? 'Pedido' : 'Order'}</p>
        <h1 class="mt-0.5 font-display text-2xl">
          <span class="font-mono text-xl">#{order._id.toString().slice(-8)}</span>
        </h1>
      </div>
      {/* Ink for a finished order, accent for one still in motion — the colour answers
          "is anything expected of me" before the words are read. */}
      <span class={`status-pill ${order.status === 'paid' ? 'status-pill-done' : ''}`}>
        <span class="h-1.5 w-1.5 rounded-full bg-current" aria-hidden="true"></span>
        {transferInReview ? t.transfer.inReviewTitle : t.account.statuses[order.status]}
      </span>
    </div>

    {paymentNotice && <p class="panel mt-5 p-4 text-sm text-accent">{paymentNotice}</p>}

    {/* One plate, four messages. A buyer coming back to this page should never have to
        work out which of them applies to them. */}
    {
      order.status === 'pending' && !transferInReview && !transferRejected && (
        <p class="mt-5 text-sm text-ink-muted">
          {lang === 'es'
            ? 'Estamos esperando la confirmación del pago. Esta página se actualizará automáticamente una vez confirmado.'
            : "We're waiting on payment confirmation. This page will reflect it once confirmed."}
        </p>
      )
    }

    {
      transferInReview && (
        // Replaces the generic waiting line rather than joining it: a buyer who has already
        // uploaded a receipt is not waiting on a gateway, they are waiting on a person, and
        // telling them the page will update "automatically" would be a promise about a
        // review that happens on someone else's schedule.
        <section class="panel mt-5 flex items-start gap-3 border-accent/30 bg-accent-wash p-4">
          <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-accent/15 text-accent">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="8.5" />
              <path d="M12 7.5V12l3 2" />
            </svg>
          </span>
          <div>
            <h2 class="font-display text-base">{t.transfer.inReviewTitle}</h2>
            <p class="mt-1 text-sm text-ink-muted">{t.transfer.inReview}</p>
          </div>
        </section>
      )
    }

    {
      transferRejected && (
        <section class="panel mt-5 flex items-start gap-3 border-accent p-4">
          <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-accent text-accent-ink">
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="8.5" />
              <path d="M12 8v5" />
              <path d="M12 16v.2" />
            </svg>
          </span>
          <div>
            <h2 class="font-display text-base">{t.transfer.rejectedTitle}</h2>
            {latestTransfer?.rejectionReason && (
              <p class="mt-1 text-sm text-ink-muted">
                {t.transfer.rejected.replace('{reason}', latestTransfer.rejectionReason)}
              </p>
            )}
          </div>
        </section>
      )
    }

    {
      order.status === 'pending' && order.kind === 'purchase' && !transferInReview && (
        <div class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-3">
          {/* The recovery path for an abandoned payment. `data-astro-reload` is required,
              not decorative: a soft navigation would not re-evaluate Payphone's CDN module,
              so the widget on the other side would have nothing to render with. */}
          <a href={`/${lang}/checkout/${order._id.toString()}`} data-astro-reload class="btn btn-primary px-6 py-3">
            {t.order.completePayment}
            <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h13" />
              <path d="M13 6l6 6-6 6" />
            </svg>
          </a>
          <a href={`/${lang}/checkout/${order._id.toString()}/transfer`} class="text-sm underline transition-colors hover:text-accent">
            {transferRejected ? t.transfer.tryAgain : t.transfer.payByTransfer}
          </a>
        </div>
      )
    }

    <section class="panel mt-5 p-4">
      <ul class="divide-y divide-border">
        {
          order.items.map((item) => {
            const thumb = thumbs[item.photoId.toString()];
            return (
              <li class="flex items-center gap-3 py-2.5">
                {thumb ? (
                  <picture class="frame h-11 w-11 shrink-0 bg-border">
                    <source srcset={thumb.webpUrl} type="image/webp" />
                    <img src={thumb.jpegUrl} alt={item.photoTitle} class="h-full w-full object-cover" />
                  </picture>
                ) : (
                  <span class="frame h-11 w-11 shrink-0 bg-border" aria-hidden="true" />
                )}
                <span class="min-w-0 flex-1">
                  <span class="block truncate text-sm">{item.photoTitle}</span>
                  <span class="block text-xs text-ink-muted">{t.cart.digitalFile}</span>
                </span>
                <span class="shrink-0 text-sm">${(item.totalCents / 100).toFixed(2)}</span>
              </li>
            );
          })
        }
      </ul>

      <div class="mt-3 flex items-baseline justify-between border-t border-border-strong pt-3">
        <span class="font-display text-base">{t.checkout.total}</span>
        <span class="font-display text-xl">${(order.totalCents / 100).toFixed(2)}</span>
      </div>

      {
        paymentMethodLabel && (
          <p class="mt-3 flex justify-between border-t border-border pt-3 text-xs text-ink-muted">
            <span>{t.order.methodLabel}</span>
            <span class="text-ink">{paymentMethodLabel}</span>
          </p>
        )
      }
    </section>

    {/* The trail. Cheap on a card order (three ticks), and the whole answer on a transfer
        that has been sitting with a human since yesterday. */}
    <section class="panel mt-4 p-4">
      <h2 class="text-[11px] uppercase tracking-widest text-ink-muted">{t.order.tracking.title}</h2>
      <ol class="mt-3">
        {
          tracking.map((beat, i) => (
            <li class="relative flex gap-3 pb-4 last:pb-0">
              {i < tracking.length - 1 && <span class="absolute left-[11px] top-6 bottom-0 w-px bg-border" aria-hidden="true"></span>}
              <span
                class={`relative z-10 inline-flex h-[23px] w-[23px] shrink-0 items-center justify-center rounded-full border ${
                  beat.done
                    ? 'border-ink bg-ink text-surface'
                    : beat.now
                      ? 'border-accent bg-raised text-accent shadow-[0_0_0_3px_var(--color-accent-wash)]'
                      : 'border-border-strong bg-raised text-ink-muted'
                }`}
              >
                {beat.done ? (
                  <svg class="h-3 w-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12.5l4.5 4.5L19 7.5" />
                  </svg>
                ) : (
                  <span class="h-1.5 w-1.5 rounded-full bg-current" aria-hidden="true"></span>
                )}
              </span>
              <span class="pt-0.5">
                <span class="block text-sm">{beat.title}</span>
                <span class="block text-xs text-ink-muted">{beat.meta}</span>
              </span>
            </li>
          ))
        }
      </ol>
    </section>

    {
      order.status === 'paid' && digitalItemCount > 0 && (
        <section class="panel mt-4 p-4">
          <h2 class="text-[11px] uppercase tracking-widest text-ink-muted">{t.order.downloadsTitle}</h2>

          <ul class="mt-2 divide-y divide-border">
            {order.items.map((item) => (
              <li class="group flex items-center justify-between gap-4 py-2.5">
                <span class="text-sm">{item.photoTitle}</span>
                {/*
                 * data-astro-reload, not decoration: ClientRouter would otherwise try to
                 * swap this in as a page. The endpoint answers with a redirect to a
                 * short-lived presigned URL carrying its own attachment disposition, which
                 * is also why there is no `download` attribute — that attribute is ignored
                 * cross-origin, and the header is what actually saves the file.
                 */}
                <a
                  href={`/api/order-download/${order._id.toString()}/${item.photoId.toString()}`}
                  data-astro-reload
                  class="btn btn-ghost shrink-0 px-4 py-2 text-xs transition-transform group-hover:translate-x-0.5"
                >
                  <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 4v10" />
                    <path d="M8 11l4 4 4-4" />
                    <path d="M5 19h14" />
                  </svg>
                  {t.order.download}
                </a>
              </li>
            ))}
          </ul>

          <p class="mt-3 border-t border-border pt-3 text-xs text-ink-muted">{downloadsValidity}</p>
          <p class="mt-1.5 text-xs text-ink-muted">{emailNotice}</p>
        </section>
      )
    }

  </div>
</BaseLayout>

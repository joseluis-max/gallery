---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getDictionary, type Locale } from '../../lib/i18n';

const lang = Astro.params.lang as Locale;
const t = getDictionary(lang);
---

<BaseLayout title={`${t.about.title} — José Valdiviezo`} description={t.about.body} lang={lang}>
  <div class="mx-auto max-w-2xl px-6 py-16 md:px-12" data-reveal>
    <h1 class="font-display text-3xl">{t.about.title}</h1>
    <p class="mt-6 text-lg leading-relaxed text-ink-muted">{t.about.body}</p>
  </div>
</BaseLayout>

<script>
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('[data-reveal]').forEach((el) => el.classList.add('is-visible'));
  });
</script>

<style>
  [data-reveal] {
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 0.6s ease-out,
      transform 0.6s ease-out;
  }
  [data-reveal].is-visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

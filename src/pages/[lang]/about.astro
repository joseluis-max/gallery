---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { createStorage, getDbConfig } from '../../lib/config';
import { getDb } from '../../lib/db';
import { getDictionary, type Locale } from '../../lib/i18n';
import { getPhotoImageUrls, getPublishedPhotos } from '../../lib/photos';

const lang = Astro.params.lang as Locale;
const t = getDictionary(lang);

/**
 * Three frames from the portfolio — the personal work, not a competition — beside the
 * writing. Portfolio photographs carry `competitionId: null`, so this is the same query
 * the portfolio page runs, truncated. An empty portfolio simply drops the column rather
 * than leaving three grey boxes.
 */
const db = await getDb(getDbConfig());
const storage = createStorage();
const frames = (await getPublishedPhotos(db, { competitionId: null })).slice(0, 3).map((photo) => {
  const urls = getPhotoImageUrls(photo, storage);
  return { slug: photo.slug, title: photo.title[lang], webpUrl: urls.webp, jpegUrl: urls.jpeg };
});
---

<BaseLayout title={`${t.about.title} — José Valdiviezo`} description={t.about.body} lang={lang}>
  {/*
    Two rails: the writing on the left at a readable measure, three of his own frames on
    the right. There is no photograph of José in the repository, and his work says more
    about him than a stand-in portrait would.
  */}
  <div class="mx-auto grid max-w-5xl gap-10 px-6 py-12 md:grid-cols-[1.15fr_1fr] md:gap-12 md:px-12" data-reveal>
    <div>
      <p class="text-[10px] uppercase tracking-[0.14em] text-ink-muted">{t.about.eyebrow}</p>
      <h1 class="mt-2 font-display text-4xl leading-[1.1]">{t.about.title}</h1>
      <p class="mt-5 text-lg leading-relaxed text-ink-muted" style="text-wrap: pretty;">{t.about.body}</p>

      <div class="mt-7 flex flex-wrap gap-2.5">
        <a href={`/${lang}/competitions`} class="btn btn-primary px-6 py-3">
          {t.nav.competitions}
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h13" />
            <path d="M13 6l6 6-6 6" />
          </svg>
        </a>
        <a href={`/${lang}/portfolio`} class="btn btn-ghost px-6 py-3">{t.nav.portfolio}</a>
      </div>

      {/* Location and an invitation — no email address, because there isn't one in the
          repository to put here. Add one and this becomes a mailto row. */}
      <div class="panel mt-7 p-4">
        <p class="text-[10px] uppercase tracking-[0.14em] text-ink-muted">{t.about.contactTitle}</p>
        <p class="mt-2.5 flex items-center gap-2.5 text-sm">
          <svg class="h-4 w-4 shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="11" r="3" />
            <path d="M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11z" />
          </svg>
          {t.about.contactLocation}
        </p>
        <p class="mt-2 text-xs text-ink-muted">{t.about.contactInvite}</p>
      </div>
    </div>

    {
      frames.length > 0 && (
        <div class="grid gap-2.5">
          <a href={`/${lang}/gallery/${frames[0].slug}`} class="frame block aspect-[4/3] bg-border">
            <picture>
              <source srcset={frames[0].webpUrl} type="image/webp" />
              <img src={frames[0].jpegUrl} alt={frames[0].title} loading="lazy" decoding="async" class="h-full w-full object-cover" />
            </picture>
          </a>
          {frames.length > 2 && (
            <div class="grid grid-cols-2 gap-2.5">
              {frames.slice(1, 3).map((frame) => (
                <a href={`/${lang}/gallery/${frame.slug}`} class="frame block aspect-square bg-border">
                  <picture>
                    <source srcset={frame.webpUrl} type="image/webp" />
                    <img src={frame.jpegUrl} alt={frame.title} loading="lazy" decoding="async" class="h-full w-full object-cover" />
                  </picture>
                </a>
              ))}
            </div>
          )}
          <p class="text-xs text-ink-muted">{t.about.portfolioNote}</p>
        </div>
      )
    }
  </div>
</BaseLayout>

<script>
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('[data-reveal]').forEach((el) => el.classList.add('is-visible'));
  });
</script>

<style>
  [data-reveal] {
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 0.6s ease-out,
      transform 0.6s ease-out;
  }
  [data-reveal].is-visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

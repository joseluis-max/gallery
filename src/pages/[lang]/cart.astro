---
import { ObjectId } from 'mongodb';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { createStorage, getDbConfig } from '../../lib/config';
import { getDb } from '../../lib/db';
import { getDictionary, type Locale } from '../../lib/i18n';
import { getPhotoImageUrls, type PhotoDoc } from '../../lib/photos';
import { computeDigitalPrice } from '../../lib/pricing';
import { getSettings } from '../../lib/settings';

const lang = Astro.params.lang as Locale;
const t = getDictionary(lang);

const cart = (await Astro.session?.get('cart')) ?? [];
const db = await getDb(getDbConfig());
const settings = await getSettings(db);
const storage = createStorage();

interface CartLine {
  lineId: string;
  title: string;
  webpUrl: string;
  jpegUrl: string;
  detail: string;
  priceCents: number;
}

const lines: CartLine[] = [];
let unavailableCount = 0;

for (const item of cart) {
  let photo: PhotoDoc | null = null;
  try {
    photo = await db.collection<PhotoDoc>('photos').findOne({ _id: new ObjectId(item.photoId), status: 'published' });
  } catch {
    photo = null;
  }
  if (!photo) {
    unavailableCount++;
    continue;
  }

  const urls = getPhotoImageUrls(photo, storage);
  const quote = computeDigitalPrice(1, { settings, digitalPriceOverrideCents: photo.pricing?.digitalPriceCents });

  lines.push({
    lineId: item.lineId,
    title: photo.title[lang],
    webpUrl: urls.webp,
    jpegUrl: urls.jpeg,
    detail: t.cart.digitalFile,
    priceCents: quote.totalCents,
  });
}

const totalCents = lines.reduce((sum, line) => sum + line.priceCents, 0);
---

<BaseLayout title={`${t.cart.title} — José Valdiviezo`} lang={lang}>
  <div class="mx-auto max-w-2xl px-6 py-16" data-cart-page data-lang={lang}>
    <h1 class="font-display text-2xl">{t.cart.title}</h1>

    {
      unavailableCount > 0 && (
        <p class="panel mt-4 p-3 text-sm text-accent">{t.cart.unavailable.replace('{count}', String(unavailableCount))}</p>
      )
    }

    {lines.length === 0 && <p class="mt-8 text-ink-muted">{t.cart.empty}</p>}

    {
      lines.length > 0 && (
        <ul class="mt-8 divide-y divide-border border-y border-border">
          {lines.map((line) => (
            <li class="flex items-center gap-4 py-4" data-cart-line data-line-id={line.lineId}>
              <picture class="frame h-20 w-20 shrink-0 bg-border">
                <source srcset={line.webpUrl} type="image/webp" />
                <img src={line.jpegUrl} alt={line.title} class="h-full w-full object-cover" />
              </picture>
              {/* No quantity control: a digital file has no quantity. Buying the same
                  photo twice delivers the same single download token, so the cart dedupes
                  on add instead of counting. */}
              <div class="flex-1">
                <p>{line.title}</p>
                <p class="text-sm text-ink-muted">{line.detail}</p>
              </div>
              <p>${(line.priceCents / 100).toFixed(2)}</p>
              <button type="button" data-remove data-line-id={line.lineId} class="text-ink-muted hover:text-accent" aria-label={t.cart.remove}>
                &times;
              </button>
            </li>
          ))}
        </ul>
      )
    }

    {
      lines.length > 0 && (
        <div class="mt-6 flex items-center justify-between">
          <span class="font-display text-xl">{t.cart.total}</span>
          <span class="font-display text-xl">${(totalCents / 100).toFixed(2)}</span>
        </div>
      )
    }

    {
      lines.length > 0 && (
        <button type="button" data-checkout class="btn btn-primary mt-8 w-full py-3">
          {t.cart.checkout}
        </button>
      )
    }
  </div>
</BaseLayout>

<script>
  import { actions } from 'astro:actions';

  document.addEventListener('astro:page-load', () => {
    const root = document.querySelector<HTMLElement>('[data-cart-page]');
    if (!root || root.dataset.bound === 'true') return;
    root.dataset.bound = 'true';

    root.querySelectorAll<HTMLButtonElement>('[data-remove]').forEach((button) => {
      button.addEventListener('click', async () => {
        await actions.removeFromCart({ lineId: button.dataset.lineId! });
        window.location.reload();
      });
    });

    const checkoutButton = root.querySelector<HTMLButtonElement>('[data-checkout]');
    checkoutButton?.addEventListener('click', async () => {
      checkoutButton.disabled = true;
      const lang = root.dataset.lang as 'es' | 'en';
      const { data, error } = await actions.checkout({ lang });
      if (error || !data?.url) {
        alert(error?.message ?? 'Checkout failed');
        checkoutButton.disabled = false;
        return;
      }
      window.location.href = data.url;
    });
  });
</script>

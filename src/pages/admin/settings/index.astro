---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getDbConfig } from '../../../lib/config';
import { getDb } from '../../../lib/db';
import { getSettings } from '../../../lib/settings';

const db = await getDb(getDbConfig());
const settings = await getSettings(db);
---

<AdminLayout title="Settings">
  <h1 class="font-display text-2xl">Settings</h1>
  <p class="mt-2 text-sm text-ink-muted">
    Every save here is recorded with a before/after diff — see <a href="/admin/activity" class="underline">Activity</a>.
  </p>

  <form data-settings-form class="mt-6 max-w-sm space-y-6">
    <label class="block text-sm">
      Download price (cents)
      <input type="number" min="0" step="1" name="digitalPriceCents" value={settings.digitalPriceCents} class="field mt-1 block w-full" />
      <span class="mt-1 block text-xs text-ink-muted">
        The default price of a digital download. Individual photographs can override it from their own edit page.
      </span>
    </label>

    <div class="flex items-center gap-3">
      <button type="submit" class="btn btn-primary py-2">Save</button>
      <span data-save-status class="text-sm text-ink-muted"></span>
    </div>
  </form>
</AdminLayout>

<script>
  import { actions } from 'astro:actions';

  const form = document.querySelector<HTMLFormElement>('[data-settings-form]')!;
  const statusEl = document.querySelector<HTMLElement>('[data-save-status]')!;

  form.addEventListener('submit', async (event) => {
    event.preventDefault();
    statusEl.textContent = 'Saving…';

    const value = (form.elements.namedItem('digitalPriceCents') as HTMLInputElement).value;
    const { error } = await actions.admin.saveSettings({ digitalPriceCents: Number(value) });

    statusEl.textContent = error ? `Error: ${error.message}` : 'Saved.';
  });
</script>

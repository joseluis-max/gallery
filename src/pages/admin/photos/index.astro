---
import { ObjectId } from 'mongodb';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Icon from '../../../components/admin/Icon.astro';
import { listAllCompetitions } from '../../../lib/competitions';
import { createStorage, getDbConfig } from '../../../lib/config';
import { getDb } from '../../../lib/db';
import type { PhotoDoc } from '../../../lib/photos';

const db = await getDb(getDbConfig());
const storage = createStorage();

const statusFilter = Astro.url.searchParams.get('status');
// 'portfolio' is a real filter value, not an absent one — it selects competitionId: null.
const competitionFilter = Astro.url.searchParams.get('competition');

const query: Record<string, unknown> = {};
if (statusFilter) query.status = statusFilter;
if (competitionFilter === 'portfolio') query.competitionId = null;
else if (competitionFilter) query.competitionId = new ObjectId(competitionFilter);

const photos = await db.collection<PhotoDoc>('photos').find(query).sort({ order: 1, createdAt: -1 }).toArray();
const allCompetitions = await listAllCompetitions(db);
const competitionNames = new Map(allCompetitions.map((c) => [c._id.toString(), c.name.en || c.name.es]));

const draftCount = photos.filter((photo) => photo.status === 'draft').length;
---

<AdminLayout title="Photos">
  <div class="flex items-center justify-between">
    <h1 class="font-display text-2xl">Photos</h1>
    <a href="/admin/upload" class="btn btn-primary py-1.5">
      <Icon name="upload" />
      Upload new
    </a>
  </div>

  <div class="mt-4 flex flex-wrap gap-2 text-xs uppercase tracking-widest">
    <a href="/admin/photos" class={`chip ${!statusFilter && !competitionFilter ? 'border-ink bg-ink text-surface' : 'text-ink-muted'}`}>All</a>
    <a href="/admin/photos?status=draft" class={`chip ${statusFilter === 'draft' ? 'border-ink bg-ink text-surface' : 'text-ink-muted'}`}>Draft</a>
    <a href="/admin/photos?status=published" class={`chip ${statusFilter === 'published' ? 'border-ink bg-ink text-surface' : 'text-ink-muted'}`}>Published</a>
    <a href="/admin/photos?competition=portfolio" class={`chip ${competitionFilter === 'portfolio' ? 'border-ink bg-ink text-surface' : 'text-ink-muted'}`}>Portfolio</a>
    {allCompetitions.map((c) => (
      <a
        href={`/admin/photos?competition=${c._id.toString()}`}
        class={`chip ${competitionFilter === c._id.toString() ? 'border-ink bg-ink text-surface' : 'text-ink-muted'}`}
      >
        {c.name.en || c.name.es}
      </a>
    ))}
  </div>

  {
    photos.length > 0 && (
      <div class="panel mt-6 flex flex-wrap items-center gap-x-4 gap-y-3 p-3" data-bulk-bar>
        <label class="flex items-center gap-2 text-sm">
          <input type="checkbox" data-select-all class="h-4 w-4 accent-[var(--color-ink)]" />
          Select all
        </label>
        <span class="text-sm text-ink-muted" data-selection-count>None selected</span>

        <div class="ms-auto flex flex-wrap items-center gap-2">
          <button type="button" data-bulk-publish class="btn btn-ghost py-1.5" disabled>
            <Icon name="eye" />
            Publish selected
          </button>
          <button type="button" data-bulk-unpublish class="btn btn-ghost py-1.5" disabled>
            <Icon name="eye-off" />
            Unpublish selected
          </button>
          {/* Acts on the filtered view, not the whole library — publishing "all" from the
              Portfolio tab must not quietly publish every competition too. */}
          <button type="button" data-publish-all class="btn btn-primary py-1.5" disabled={draftCount === 0}>
            <Icon name="check-square" />
            {draftCount === 0 ? 'All published' : `Publish all ${draftCount} draft${draftCount === 1 ? '' : 's'}`}
          </button>
        </div>
      </div>
    )
  }

  <p data-bulk-status class="mt-3 text-sm text-ink-muted" hidden></p>

  <table class="mt-6 w-full text-sm" data-photos-table>
    <thead>
      <tr class="border-b border-border-strong text-left text-xs uppercase tracking-widest text-ink-muted">
        <th class="py-2 w-8"><span class="sr-only">Select</span></th>
        <th class="py-2"></th>
        <th class="py-2">Title</th>
        <th class="py-2">Status</th>
        <th class="py-2">Competition</th>
        <th class="py-2"></th>
      </tr>
    </thead>
    <tbody data-reorder-body>
      {
        photos.map((photo) => {
          const jpegUrl = storage.publicUrl(photo.storage.publicKey.replace(/\.webp$/i, '.jpg'));
          const isPublished = photo.status === 'published';
          const title = photo.title.en || photo.slug;
          return (
            <tr class="border-b border-border" draggable="true" data-photo-row data-photo-id={photo._id.toString()} data-status={photo.status}>
              <td class="py-2">
                <input
                  type="checkbox"
                  data-photo-check
                  value={photo._id.toString()}
                  aria-label={`Select ${title}`}
                  class="h-4 w-4 accent-[var(--color-ink)]"
                />
              </td>
              <td class="py-2 pr-3">
                <img src={jpegUrl} alt="" class="h-10 w-14 object-cover" />
              </td>
              <td class="py-2">
                <a href={`/admin/photos/${photo._id.toString()}`} class="hover:underline">
                  {title}
                </a>
              </td>
              <td class="py-2 capitalize" data-status-cell>{photo.status}</td>
              <td class="py-2 text-ink-muted">
                {photo.competitionId ? (competitionNames.get(photo.competitionId.toString()) ?? '—') : 'Portfolio'}
              </td>
              <td class="py-2">
                <div class="flex items-center justify-end gap-1">
                  <button
                    type="button"
                    data-toggle-publish
                    data-photo-id={photo._id.toString()}
                    data-published={String(isPublished)}
                    class="btn-icon"
                    title={isPublished ? 'Unpublish' : 'Publish'}
                    aria-label={`${isPublished ? 'Unpublish' : 'Publish'} ${title}`}
                  >
                    <Icon name={isPublished ? 'eye-off' : 'eye'} />
                  </button>
                  <button
                    type="button"
                    data-delete
                    data-photo-id={photo._id.toString()}
                    class="btn-icon btn-icon-danger"
                    title="Delete"
                    aria-label={`Delete ${title}`}
                  >
                    <Icon name="trash" />
                  </button>
                </div>
              </td>
            </tr>
          );
        })
      }
      {photos.length === 0 && (
        <tr>
          <td colspan="6" class="py-4 text-ink-muted">No photos match this filter.</td>
        </tr>
      )}
    </tbody>
  </table>
</AdminLayout>

<script>
  import { actions } from 'astro:actions';
  import { setPhotosPublishedInChunks } from '../../../lib/bulkPublish';

  const selectAll = document.querySelector<HTMLInputElement>('[data-select-all]');
  const selectionCount = document.querySelector<HTMLElement>('[data-selection-count]');
  const bulkPublish = document.querySelector<HTMLButtonElement>('[data-bulk-publish]');
  const bulkUnpublish = document.querySelector<HTMLButtonElement>('[data-bulk-unpublish]');
  const publishAll = document.querySelector<HTMLButtonElement>('[data-publish-all]');
  const bulkStatus = document.querySelector<HTMLElement>('[data-bulk-status]')!;
  const checkboxes = Array.from(document.querySelectorAll<HTMLInputElement>('[data-photo-check]'));

  function selectedIds(): string[] {
    return checkboxes.filter((box) => box.checked).map((box) => box.value);
  }

  function syncSelectionUi() {
    const count = selectedIds().length;
    if (selectionCount) selectionCount.textContent = count === 0 ? 'None selected' : `${count} selected`;
    if (bulkPublish) bulkPublish.disabled = count === 0;
    if (bulkUnpublish) bulkUnpublish.disabled = count === 0;
    if (selectAll) {
      selectAll.checked = count > 0 && count === checkboxes.length;
      // Partial selection reads as a dash rather than as either extreme, so the header
      // box never claims the whole page is selected when it isn't.
      selectAll.indeterminate = count > 0 && count < checkboxes.length;
    }
  }

  function setBusy(busy: boolean) {
    for (const button of [bulkPublish, bulkUnpublish, publishAll]) {
      if (button) button.disabled = busy || button.dataset.permanentlyDisabled === 'true';
    }
    if (!busy) syncSelectionUi();
  }

  function report(message: string, isError = false) {
    bulkStatus.hidden = false;
    bulkStatus.textContent = message;
    bulkStatus.classList.toggle('text-accent', isError);
    bulkStatus.classList.toggle('text-ink-muted', !isError);
  }

  async function applyBulk(ids: string[], published: boolean) {
    if (ids.length === 0) return;
    setBusy(true);
    report(`${published ? 'Publishing' : 'Unpublishing'} ${ids.length}…`);

    const result = await setPhotosPublishedInChunks(ids, (chunk) =>
      actions.admin.setPhotosPublished({ photoIds: chunk, published }),
    );

    if (result.error) {
      report(`Error: ${result.error}`, true);
      setBusy(false);
      return;
    }
    // Reloading rather than patching the rows: status cells, the per-row toggle icons,
    // and the draft count in "Publish all" all derive from the server's view, and a
    // filtered list may no longer contain what was just changed.
    window.location.reload();
  }

  selectAll?.addEventListener('change', () => {
    for (const box of checkboxes) box.checked = selectAll.checked;
    syncSelectionUi();
  });

  for (const box of checkboxes) box.addEventListener('change', syncSelectionUi);

  bulkPublish?.addEventListener('click', () => applyBulk(selectedIds(), true));
  bulkUnpublish?.addEventListener('click', () => applyBulk(selectedIds(), false));

  publishAll?.addEventListener('click', () => {
    // Every row currently rendered, which is the filtered set — not the whole library.
    const drafts = document
      .querySelectorAll<HTMLElement>('[data-photo-row][data-status="draft"]');
    const ids = Array.from(drafts).map((row) => row.dataset.photoId!);
    if (ids.length === 0) return;
    if (!confirm(`Publish all ${ids.length} draft photograph(s) in this view? They become visible on the public site.`)) return;
    applyBulk(ids, true);
  });

  if (publishAll?.disabled) publishAll.dataset.permanentlyDisabled = 'true';
  syncSelectionUi();

  document.querySelectorAll<HTMLButtonElement>('[data-toggle-publish]').forEach((button) => {
    button.addEventListener('click', async () => {
      const photoId = button.dataset.photoId!;
      const published = button.dataset.published === 'true';
      button.disabled = true;
      const { error } = await actions.admin.setPhotoPublished({ photoId, published: !published });
      if (error) {
        alert(error.message);
        button.disabled = false;
        return;
      }
      window.location.reload();
    });
  });

  document.querySelectorAll<HTMLButtonElement>('[data-delete]').forEach((button) => {
    button.addEventListener('click', async () => {
      if (!confirm('Delete this photo? This cannot be undone.')) return;
      const photoId = button.dataset.photoId!;
      button.disabled = true;
      const { error } = await actions.admin.deletePhoto({ photoId });
      if (error) {
        alert(error.message);
        button.disabled = false;
        return;
      }
      window.location.reload();
    });
  });

  // Minimal native HTML5 drag-reorder — drop target reorders the row, then persists
  // the full list order in one call.
  const body = document.querySelector<HTMLElement>('[data-reorder-body]');
  let draggedRow: HTMLElement | null = null;

  body?.querySelectorAll<HTMLElement>('[data-photo-row]').forEach((row) => {
    row.addEventListener('dragstart', (event) => {
      // Dragging *from* the checkbox or a row button would otherwise pick the whole row
      // up, which makes ticking a box on a slow click reorder the gallery.
      if ((event.target as HTMLElement).closest('input, button')) {
        event.preventDefault();
        return;
      }
      draggedRow = row;
    });
    row.addEventListener('dragover', (event) => {
      event.preventDefault();
      if (!draggedRow || draggedRow === row) return;
      const rect = row.getBoundingClientRect();
      const after = (event as DragEvent).clientY > rect.top + rect.height / 2;
      row.parentElement?.insertBefore(draggedRow, after ? row.nextSibling : row);
    });
    row.addEventListener('dragend', async () => {
      if (!draggedRow) return;
      draggedRow = null;
      const orderedIds = Array.from(body.querySelectorAll<HTMLElement>('[data-photo-row]')).map(
        (r) => r.dataset.photoId!,
      );
      await actions.admin.reorderPhotos({ orderedIds });
    });
  });
</script>

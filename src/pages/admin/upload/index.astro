---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { listAllCompetitions } from '../../../lib/competitions';
import { getDbConfig } from '../../../lib/config';
import { getDb } from '../../../lib/db';

const db = await getDb(getDbConfig());
const competitions = await listAllCompetitions(db);
// Preselected when arriving from a competition's own page, so "upload into this
// competition" actually does.
const preselected = Astro.url.searchParams.get('competition') ?? '';
---

<AdminLayout title="Upload">
  <h1 class="font-display text-2xl">Upload</h1>
  <p class="mt-2 text-sm text-ink-muted">
    Files upload directly from your browser to the storage bucket — they never pass through the app server. Each one is then
    processed (rotate, watermark, derivatives) and lands here as a draft.
  </p>

  <label class="mt-6 block max-w-sm text-sm">
    Add to competition
    <select data-competition-select class="field mt-1 block w-full">
      <option value="" selected={!preselected}>— Portfolio (no competition) —</option>
      {
        competitions.map((competition) => (
          <option value={competition._id.toString()} selected={preselected === competition._id.toString()}>
            {competition.name.en || competition.name.es}
            {competition.status === 'draft' ? ' (draft)' : ''}
          </option>
        ))
      }
    </select>
    <span class="mt-1 block text-xs text-ink-muted">Applies to every file in this batch. Change it before dropping files.</span>
  </label>

  <div
    data-dropzone
    class="mt-6 flex min-h-40 flex-col items-center justify-center rounded-lg border-2 border-dashed border-border p-10 text-center text-sm text-ink-muted"
  >
    <p>Drag JPEG/PNG/TIFF files here, or</p>
    <label class="mt-2 cursor-pointer underline">
      browse
      <input type="file" data-file-input multiple accept="image/jpeg,image/png,image/tiff" class="hidden" />
    </label>
  </div>

  <table class="mt-8 w-full text-sm">
    <thead>
      <tr class="border-b border-border-strong text-left text-xs uppercase tracking-widest text-ink-muted">
        <th class="py-2">File</th>
        <th class="py-2">Status</th>
        <th class="py-2">Progress</th>
        <th class="py-2"></th>
      </tr>
    </thead>
    <tbody data-jobs-body>
      <tr>
        <td colspan="4" class="py-4 text-ink-muted">No uploads yet.</td>
      </tr>
    </tbody>
  </table>
</AdminLayout>

<script>
  import { actions } from 'astro:actions';

  interface LocalUpload {
    jobId?: string;
    filename: string;
    status: string;
    progressPct: number;
    error?: string;
  }

  const dropzone = document.querySelector<HTMLElement>('[data-dropzone]')!;
  const fileInput = document.querySelector<HTMLInputElement>('[data-file-input]')!;
  const jobsBody = document.querySelector<HTMLElement>('[data-jobs-body]')!;
  const localUploads = new Map<string, LocalUpload>();

  function render() {
    const rows = Array.from(localUploads.values());
    if (rows.length === 0) {
      jobsBody.innerHTML = '<tr><td colspan="4" class="py-4 text-ink-muted">No uploads yet.</td></tr>';
      return;
    }
    jobsBody.innerHTML = rows
      .map(
        (row) => `
        <tr class="border-b border-border" data-row="${row.jobId ?? row.filename}">
          <td class="py-2">${row.filename}</td>
          <td class="py-2">${row.status}${row.error ? ` — ${row.error}` : ''}</td>
          <td class="py-2">${row.status === 'uploading' ? `${row.progressPct}%` : ''}</td>
          <td class="py-2">${row.status === 'failed' && row.jobId ? `<button type="button" data-retry="${row.jobId}" class="underline">Retry</button>` : ''}</td>
        </tr>`,
      )
      .join('');

    jobsBody.querySelectorAll<HTMLButtonElement>('[data-retry]').forEach((button) => {
      button.addEventListener('click', async () => {
        const jobId = button.dataset.retry!;
        const local = [...localUploads.values()].find((u) => u.jobId === jobId);
        if (local) {
          local.status = 'processing';
          local.error = undefined;
          render();
        }
        const { error } = await actions.admin.retryUploadJob({ jobId });
        if (local) {
          if (error) {
            local.status = 'failed';
            local.error = error.message;
          } else {
            local.status = 'ready';
          }
          render();
        }
      });
    });
  }

  async function uploadFile(file: File) {
    const key = file.name + ':' + file.size;
    const local: LocalUpload = { filename: file.name, status: 'requesting', progressPct: 0 };
    localUploads.set(key, local);
    render();

    // Read per file rather than captured once, so changing the select mid-batch applies
    // to whatever is dropped next instead of silently using a stale value.
    const competitionId = document.querySelector<HTMLSelectElement>('[data-competition-select]')?.value || undefined;

    const { data, error: requestError } = await actions.admin.requestUploadUrl({
      filename: file.name,
      contentType: file.type,
      bytes: file.size,
      competitionId,
    });
    if (requestError || !data) {
      local.status = 'failed';
      local.error = requestError?.message ?? 'Could not get upload URL';
      render();
      return;
    }

    local.jobId = data.jobId;
    local.status = 'uploading';
    render();

    // The PUT's outcome is *checked*. Resolving regardless of status (as this used to)
    // meant a rejected upload — a CORS block, an expired signature, a 403 — fell through
    // to completeUpload, which then failed with the storage layer's downstream complaint
    // ("The specified key does not exist"), sending you looking in entirely the wrong
    // place. Whatever goes wrong here is reported here.
    const uploadResult = await new Promise<{ ok: true } | { ok: false; message: string }>((resolve) => {
      const xhr = new XMLHttpRequest();
      xhr.open('PUT', data.uploadUrl);
      xhr.setRequestHeader('Content-Type', file.type);
      xhr.upload.addEventListener('progress', (event) => {
        if (event.lengthComputable) {
          local.progressPct = Math.round((event.loaded / event.total) * 100);
          render();
        }
      });
      xhr.addEventListener('load', () => {
        if (xhr.status >= 200 && xhr.status < 300) {
          resolve({ ok: true });
          return;
        }
        // Storage errors come back as an XML body whose <Message> is the useful part.
        const detail = /<Message>([^<]+)<\/Message>/.exec(xhr.responseText ?? '')?.[1];
        resolve({ ok: false, message: `storage rejected the upload (HTTP ${xhr.status})${detail ? `: ${detail}` : ''}` });
      });
      // A blocked CORS preflight and a dropped connection are indistinguishable to
      // XMLHttpRequest — both surface as `error` with status 0 — so the message names
      // both rather than guessing.
      xhr.addEventListener('error', () => {
        resolve({ ok: false, message: 'could not reach storage — blocked by CORS, or the network failed. Check the bucket CORS origins.' });
      });
      xhr.addEventListener('abort', () => resolve({ ok: false, message: 'upload aborted' }));
      xhr.addEventListener('timeout', () => resolve({ ok: false, message: 'upload timed out' }));
      xhr.send(file);
    });

    if (!uploadResult.ok) {
      local.status = 'failed';
      local.error = uploadResult.message;
      render();
      return;
    }

    local.status = 'processing';
    render();

    const { error: completeError } = await actions.admin.completeUpload({ jobId: data.jobId });
    if (completeError) {
      local.status = 'failed';
      local.error = completeError.message;
    } else {
      local.status = 'ready';
    }
    render();
  }

  function handleFiles(files: FileList | null) {
    if (!files) return;
    for (const file of Array.from(files)) uploadFile(file);
  }

  fileInput.addEventListener('change', () => handleFiles(fileInput.files));

  dropzone.addEventListener('dragover', (event) => {
    event.preventDefault();
    dropzone.classList.add('border-accent');
  });
  dropzone.addEventListener('dragleave', () => dropzone.classList.remove('border-accent'));
  dropzone.addEventListener('drop', (event) => {
    event.preventDefault();
    dropzone.classList.remove('border-accent');
    handleFiles(event.dataTransfer?.files ?? null);
  });
</script>

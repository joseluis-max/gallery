---
import { ObjectId } from 'mongodb';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { listTransfersForOrder } from '../../../lib/bankTransfer';
import { getDbConfig } from '../../../lib/config';
import { getDb } from '../../../lib/db';
import { getOrderById } from '../../../lib/orders';

const idParam = Astro.params.id as string;
let orderId: InstanceType<typeof ObjectId>;
try {
  orderId = new ObjectId(idParam);
} catch {
  return new Response('Not found', { status: 404 });
}

const db = await getDb(getDbConfig());
const order = await getOrderById(db, orderId);
if (!order) {
  return new Response('Not found', { status: 404 });
}

// Deliberately not a deep link into Payphone's merchant panel: no per-transaction URL is
// documented for it, and a fabricated link that 404s is worse than an id an operator can
// paste into their search. If Payphone confirms such a URL exists, this becomes a link.
const payment = order.payment;
const card = payment && payment.cardBrand ? `${payment.cardBrand} •••• ${payment.lastDigits ?? '????'}` : null;
// Orders paid before there was a second method carry no `method` at all, and they were all
// Payphone — so the fallback is a fact about history, not a guess.
const isTransfer = payment?.method === 'transfer';

// This is where a bank transfer is actually decided. The receipt sits beside the total and
// the customer, which is the whole reason the review lives here rather than on the queue
// page: approving means "this money arrived, for this order", and both halves of that
// sentence need to be on screen.
const transfers = await listTransfersForOrder(db, order._id);
const pendingReview = transfers.find((transfer) => transfer.status === 'in-review');
/** No browser renders HEIC, so those get a download link instead of a dead <img>. */
const previewable = (contentType: string) => contentType.startsWith('image/') && !contentType.includes('hei');
---

<AdminLayout title={`Order #${order._id.toString().slice(-8)}`}>
  <a href="/admin/orders" class="text-xs uppercase tracking-widest text-ink-muted hover:text-ink">&larr; Orders</a>

  <div class="mt-4 flex items-center justify-between">
    <h1 class="font-display text-2xl">Order #{order._id.toString().slice(-8)}</h1>
    <span class="chip uppercase tracking-widest capitalize">{order.status}</span>
  </div>

  {
    transfers.length > 0 && (
      <section
        class={`panel mt-6 p-5 ${pendingReview ? 'border-accent' : ''}`}
        data-transfer-review
        data-order-total={(order.totalCents / 100).toFixed(2)}
      >
        <h2 class="text-sm uppercase tracking-widest text-accent">Bank transfer</h2>

        {pendingReview ? (
          <div class="mt-3 flex flex-wrap items-center gap-3">
            {/* The figure to match, stated once and big. The buyer never tells us what they
                transferred, so this panel cannot compare two numbers for you — it puts the
                one number that matters next to the receipt and gets out of the way. */}
            <span class="rounded-md border border-accent/40 bg-accent-wash px-4 py-2.5">
              <span class="block text-[10px] uppercase tracking-widest text-ink-muted">Expect in Banco Pichincha</span>
              <span class="font-display text-2xl text-accent">${(order.totalCents / 100).toFixed(2)}</span>
            </span>
            <span class="rounded-md border border-border px-4 py-2.5">
              <span class="block text-[10px] uppercase tracking-widest text-ink-muted">Concept / reference</span>
              <span class="font-mono text-lg">#{order._id.toString().slice(-8)}</span>
            </span>
            <p class="max-w-sm text-xs text-ink-muted">
              Approving marks the order paid, issues the download links and emails them — the same thing a card payment does.
              Rejecting emails the buyer your reason and leaves the order open so they can try again.
            </p>
          </div>
        ) : (
          <p class="mt-2 text-sm text-ink-muted">No submission is waiting for review on this order.</p>
        )}

        <ul class="mt-4 space-y-4">
          {transfers.map((transfer) => (
            <li class="border-t border-border pt-4">
              <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 text-sm">
                <span class={transfer.status === 'in-review' ? 'text-accent' : 'text-ink-muted'}>{transfer.status}</span>
                <span class="text-ink-muted">{new Date(transfer.submittedAt).toLocaleString()}</span>
                <span>${(transfer.amountCents / 100).toFixed(2)}</span>
                <span class="font-mono text-xs text-ink-muted">
                  {transfer.receipt.filename} · {Math.round(transfer.receipt.bytes / 1024)} KB
                </span>
              </div>

              {transfer.reference && (
                <p class="mt-1 text-sm">
                  <span class="text-ink-muted">Buyer reference:</span> <span class="font-mono">{transfer.reference}</span>
                </p>
              )}
              {transfer.reviewedBy && (
                <p class="mt-1 text-xs text-ink-muted">
                  Reviewed by {transfer.reviewedBy}
                  {transfer.reviewedAt ? ` · ${new Date(transfer.reviewedAt).toLocaleString()}` : ''}
                  {transfer.rejectionReason ? ` · "${transfer.rejectionReason}"` : ''}
                </p>
              )}

              {/* data-astro-reload on both: the router must not try to swap an image or a
                  PDF in as a page. */}
              <a
                href={`/api/admin/transfer-receipt/${transfer._id.toString()}`}
                target="_blank"
                rel="noopener"
                data-astro-reload
                class="mt-2 inline-block text-sm underline hover:text-accent"
              >
                Open receipt
              </a>

              {previewable(transfer.receipt.contentType) && (
                <a href={`/api/admin/transfer-receipt/${transfer._id.toString()}`} target="_blank" rel="noopener" data-astro-reload>
                  <img
                    src={`/api/admin/transfer-receipt/${transfer._id.toString()}`}
                    alt={`Receipt for order ${order._id.toString().slice(-8)}`}
                    class="mt-3 max-h-96 w-auto rounded border border-border"
                  />
                </a>
              )}

              {transfer.status === 'in-review' && (
                <div class="mt-4" data-review-controls data-transfer-id={transfer._id.toString()}>
                  <label class="block text-sm">
                    Reason (required to reject, emailed to the buyer)
                    <input
                      type="text"
                      data-reject-reason
                      maxlength="500"
                      placeholder="e.g. the receipt is for $2.00, this order is $6.00"
                      class="field mt-1 w-full"
                    />
                  </label>
                  <div class="mt-3 flex flex-wrap items-center gap-3">
                    <button type="button" data-approve class="btn btn-primary px-5 py-2">
                      Approve &amp; release downloads
                    </button>
                    <button type="button" data-reject class="btn btn-ghost px-5 py-2">
                      Reject
                    </button>
                    <span data-review-status class="text-sm text-ink-muted" />
                  </div>
                </div>
              )}
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <div class="mt-6 grid gap-8 md:grid-cols-[1.4fr_1fr]">
    <div>
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-border-strong text-left text-xs uppercase tracking-widest text-ink-muted">
            <th class="py-2">Photo</th>
            <th class="py-2">Spec</th>
            <th class="py-2">Total</th>
          </tr>
        </thead>
        <tbody>
          {
            order.items.map((item) => (
              <tr class="border-b border-border">
                <td class="py-2">{item.photoTitle}</td>
                <td class="py-2 text-ink-muted">Digital download</td>
                <td class="py-2">${(item.totalCents / 100).toFixed(2)}</td>
              </tr>
            ))
          }
        </tbody>
      </table>

      <div class="mt-4 flex justify-between text-sm">
        <span class="text-ink-muted">Subtotal</span>
        <span>${(order.subtotalCents / 100).toFixed(2)}</span>
      </div>
      <div class="mt-1 flex justify-between font-display text-lg">
        <span>Total</span>
        <span>${(order.totalCents / 100).toFixed(2)}</span>
      </div>

      <h2 class="mt-8 text-sm uppercase tracking-widest text-ink-muted">History</h2>
      <ul class="mt-3 space-y-2 text-sm">
        {
          order.history.map((entry) => (
            <li class="border-b border-border pb-2">
              <span class="text-ink-muted">{new Date(entry.at).toLocaleString()}</span> — <span class="capitalize">{entry.status}</span>
              {entry.note && <span class="text-ink-muted"> · {entry.note}</span>}
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h2 class="text-sm uppercase tracking-widest text-ink-muted">Customer</h2>
      <p class="mt-2 text-sm">{order.customer.email || '—'}</p>
      <p class="mt-1 text-sm text-ink-muted">
        {
          order.userId ? (
            <a href={`/admin/customers/${order.userId.toString()}`} class="underline hover:text-ink">
              View account →
            </a>
          ) : (
            'Guest checkout — no account'
          )
        }
      </p>

      {payment && (
        <div class="mt-6 text-sm">
          <h3 class="text-xs uppercase tracking-widest text-ink-muted">Payment</h3>
          <dl class="mt-2 space-y-1">
            <div class="flex justify-between gap-4">
              <dt class="text-ink-muted">Method</dt>
              <dd>{isTransfer ? 'Bank transfer' : 'Payphone'}</dd>
            </div>
            <div class="flex justify-between gap-4">
              <dt class="text-ink-muted">{isTransfer ? 'Review id' : 'Payphone transaction'}</dt>
              <dd class="font-mono">{payment.transactionId}</dd>
            </div>
            {payment.reference && (
              <div class="flex justify-between gap-4">
                <dt class="text-ink-muted">Buyer reference</dt>
                <dd class="font-mono">{payment.reference}</dd>
              </div>
            )}
            {payment.authorizationCode && (
              <div class="flex justify-between gap-4">
                <dt class="text-ink-muted">Authorization</dt>
                <dd class="font-mono">{payment.authorizationCode}</dd>
              </div>
            )}
            {card && (
              <div class="flex justify-between gap-4">
                <dt class="text-ink-muted">Card</dt>
                <dd>{card}</dd>
              </div>
            )}
            {payment.document && (
              <div class="flex justify-between gap-4">
                <dt class="text-ink-muted">Cédula / RUC</dt>
                <dd class="font-mono">{payment.document}</dd>
              </div>
            )}
          </dl>
        </div>
      )}

    </div>
  </div>
</AdminLayout>

<script>
  import { actions } from 'astro:actions';

  document.addEventListener('astro:page-load', () => {
    const root = document.querySelector<HTMLElement>('[data-transfer-review]');
    if (!root || root.dataset.bound === 'true') return;
    root.dataset.bound = 'true';

    for (const controls of root.querySelectorAll<HTMLElement>('[data-review-controls]')) {
      const transferId = controls.dataset.transferId!;
      const approve = controls.querySelector<HTMLButtonElement>('[data-approve]')!;
      const reject = controls.querySelector<HTMLButtonElement>('[data-reject]')!;
      const reason = controls.querySelector<HTMLInputElement>('[data-reject-reason]')!;
      const status = controls.querySelector<HTMLElement>('[data-review-status]')!;

      /** Both buttons stay disabled after a decision lands: the row has been reviewed and
       *  the page is now stale, so re-clicking could only produce a confusing error. */
      function lock(message: string) {
        approve.disabled = true;
        reject.disabled = true;
        status.textContent = message;
      }

      function unlock(message: string) {
        approve.disabled = false;
        reject.disabled = false;
        status.textContent = message;
      }

      approve.addEventListener('click', async () => {
        // A transfer is money changing hands on someone's word, and it is not reversible
        // from this panel — worth one deliberate keystroke.
        if (!window.confirm(`Approve this transfer and release the downloads for $${root.dataset.orderTotal}?`)) return;

        lock('Approving…');
        const { data, error } = await actions.admin.approveTransfer({ transferId });
        if (error) return unlock(error.message ?? 'Something went wrong.');

        lock(data?.alreadyPaid ? 'Order was already paid — queue cleared.' : 'Approved. Downloads sent.');
        window.location.reload();
      });

      reject.addEventListener('click', async () => {
        const text = reason.value.trim();
        // Checked here as well as in the action so the admin is told what is missing
        // instead of meeting a schema error after a round trip.
        if (text.length < 3) {
          reason.focus();
          return unlock('Write a reason — the buyer receives it.');
        }

        lock('Rejecting…');
        const { error } = await actions.admin.rejectTransfer({ transferId, reason: text });
        if (error) return unlock(error.message ?? 'Something went wrong.');

        lock('Rejected. The buyer has been told why.');
        window.location.reload();
      });
    }
  });
</script>

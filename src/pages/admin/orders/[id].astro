---
import { ObjectId } from 'mongodb';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getDbConfig } from '../../../lib/config';
import { getDb } from '../../../lib/db';
import { getOrderById } from '../../../lib/orders';

const idParam = Astro.params.id as string;
let orderId: InstanceType<typeof ObjectId>;
try {
  orderId = new ObjectId(idParam);
} catch {
  return new Response('Not found', { status: 404 });
}

const db = await getDb(getDbConfig());
const order = await getOrderById(db, orderId);
if (!order) {
  return new Response('Not found', { status: 404 });
}

// Deliberately not a deep link into Payphone's merchant panel: no per-transaction URL is
// documented for it, and a fabricated link that 404s is worse than an id an operator can
// paste into their search. If Payphone confirms such a URL exists, this becomes a link.
const payment = order.payment;
const card = payment && payment.cardBrand ? `${payment.cardBrand} •••• ${payment.lastDigits ?? '????'}` : null;
---

<AdminLayout title={`Order #${order._id.toString().slice(-8)}`}>
  <a href="/admin/orders" class="text-xs uppercase tracking-widest text-ink-muted hover:text-ink">&larr; Orders</a>

  <div class="mt-4 flex items-center justify-between">
    <h1 class="font-display text-2xl">Order #{order._id.toString().slice(-8)}</h1>
    <span class="chip uppercase tracking-widest capitalize">{order.status}</span>
  </div>

  <div class="mt-6 grid gap-8 md:grid-cols-[1.4fr_1fr]">
    <div>
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-border-strong text-left text-xs uppercase tracking-widest text-ink-muted">
            <th class="py-2">Photo</th>
            <th class="py-2">Spec</th>
            <th class="py-2">Total</th>
          </tr>
        </thead>
        <tbody>
          {
            order.items.map((item) => (
              <tr class="border-b border-border">
                <td class="py-2">{item.photoTitle}</td>
                <td class="py-2 text-ink-muted">Digital download</td>
                <td class="py-2">${(item.totalCents / 100).toFixed(2)}</td>
              </tr>
            ))
          }
        </tbody>
      </table>

      <div class="mt-4 flex justify-between text-sm">
        <span class="text-ink-muted">Subtotal</span>
        <span>${(order.subtotalCents / 100).toFixed(2)}</span>
      </div>
      <div class="mt-1 flex justify-between font-display text-lg">
        <span>Total</span>
        <span>${(order.totalCents / 100).toFixed(2)}</span>
      </div>

      <h2 class="mt-8 text-sm uppercase tracking-widest text-ink-muted">History</h2>
      <ul class="mt-3 space-y-2 text-sm">
        {
          order.history.map((entry) => (
            <li class="border-b border-border pb-2">
              <span class="text-ink-muted">{new Date(entry.at).toLocaleString()}</span> — <span class="capitalize">{entry.status}</span>
              {entry.note && <span class="text-ink-muted"> · {entry.note}</span>}
            </li>
          ))
        }
      </ul>
    </div>

    <div>
      <h2 class="text-sm uppercase tracking-widest text-ink-muted">Customer</h2>
      <p class="mt-2 text-sm">{order.customer.email || '—'}</p>
      <p class="mt-1 text-sm text-ink-muted">
        {
          order.userId ? (
            <a href={`/admin/customers/${order.userId.toString()}`} class="underline hover:text-ink">
              View account →
            </a>
          ) : (
            'Guest checkout — no account'
          )
        }
      </p>

      {payment && (
        <div class="mt-6 text-sm">
          <h3 class="text-xs uppercase tracking-widest text-ink-muted">Payment</h3>
          <dl class="mt-2 space-y-1">
            <div class="flex justify-between gap-4">
              <dt class="text-ink-muted">Payphone transaction</dt>
              <dd class="font-mono">{payment.transactionId}</dd>
            </div>
            {payment.authorizationCode && (
              <div class="flex justify-between gap-4">
                <dt class="text-ink-muted">Authorization</dt>
                <dd class="font-mono">{payment.authorizationCode}</dd>
              </div>
            )}
            {card && (
              <div class="flex justify-between gap-4">
                <dt class="text-ink-muted">Card</dt>
                <dd>{card}</dd>
              </div>
            )}
            {payment.document && (
              <div class="flex justify-between gap-4">
                <dt class="text-ink-muted">Cédula / RUC</dt>
                <dd class="font-mono">{payment.document}</dd>
              </div>
            )}
          </dl>
        </div>
      )}

    </div>
  </div>
</AdminLayout>

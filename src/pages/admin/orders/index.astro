---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getDbConfig } from '../../../lib/config';
import { getDb } from '../../../lib/db';
import type { OrderDoc } from '../../../lib/orders';
import { listUnreconciledAttempts } from '../../../lib/payments';

const db = await getDb(getDbConfig());

// Payphone has no webhook, so the buyer's browser is a mandatory link in the fulfilment
// chain: a closed tab or a dead process can strand a payment with nothing to retry it.
// Stripe's webhook retries were the compensating control; this section is. It should
// render nothing — every row is a payment that needs a human.
//
// 10 minutes is twice Payphone's five-minute reversal window, so anything listed here has
// already passed the point where it could resolve itself.
const unreconciled = await listUnreconciledAttempts(db, 10 * 60 * 1000);
const needsAttention = unreconciled.approvedButUnfulfilled.length + unreconciled.stalledConfirms.length;

const statusFilter = Astro.url.searchParams.get('status');
const search = Astro.url.searchParams.get('q')?.trim();

const query: Record<string, unknown> = {};
if (statusFilter) query.status = statusFilter;
if (search) {
  const { ObjectId } = await import('mongodb');
  const orClauses: Record<string, unknown>[] = [{ 'customer.email': { $regex: search, $options: 'i' } }];
  try {
    orClauses.push({ _id: new ObjectId(search) });
  } catch {
    // Not a valid ObjectId — search by email only.
  }
  query.$or = orClauses;
}

const orders = await db.collection<OrderDoc>('orders').find(query).sort({ createdAt: -1 }).limit(200).toArray();
---

<AdminLayout title="Orders">
  <div class="flex items-center justify-between">
    <h1 class="font-display text-2xl">Orders</h1>
    <a href={`/admin/orders/export.csv${statusFilter ? `?status=${statusFilter}` : ''}`} class="text-sm underline">
      Export CSV
    </a>
  </div>

  {
    needsAttention > 0 && (
      <section class="panel mt-6 border-accent p-4">
        <h2 class="text-sm uppercase tracking-widest text-accent">Payments needing attention</h2>

        {unreconciled.approvedButUnfulfilled.length > 0 && (
          <div class="mt-3">
            <p class="text-sm">
              <strong>{unreconciled.approvedButUnfulfilled.length}</strong> payment(s) Payphone approved against an order that is
              not paid. The buyer was charged and has received nothing — these need fulfilling by hand.
            </p>
            <ul class="mt-2 space-y-1 text-sm">
              {unreconciled.approvedButUnfulfilled.map((attempt) => (
                <li class="flex flex-wrap items-center justify-between gap-2">
                  <a href={`/admin/orders/${attempt.orderId.toString()}`} class="underline">
                    Order #{attempt.orderId.toString().slice(-8)}
                  </a>
                  <span class="font-mono text-xs text-ink-muted">
                    tx {attempt.payphoneTransactionId ?? '—'} · ${(attempt.amountCents / 100).toFixed(2)} · {attempt.orderStatus}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        )}

        {unreconciled.stalledConfirms.length > 0 && (
          <div class="mt-4">
            <p class="text-sm">
              <strong>{unreconciled.stalledConfirms.length}</strong> confirmation(s) started and never finished. Whether the charge
              stands depends on whether Payphone received the call — check each transaction in the Payphone panel.
            </p>
            <ul class="mt-2 space-y-1 text-sm">
              {unreconciled.stalledConfirms.map((attempt) => (
                <li class="flex flex-wrap items-center justify-between gap-2">
                  <a href={`/admin/orders/${attempt.orderId.toString()}`} class="underline">
                    Order #{attempt.orderId.toString().slice(-8)}
                  </a>
                  <span class="font-mono text-xs text-ink-muted">
                    tx {attempt.payphoneTransactionId ?? '—'} · started {attempt.confirmStartedAt?.toISOString().slice(0, 16) ?? '—'}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </section>
    )
  }

  <form class="mt-4 flex flex-wrap items-center gap-3 text-sm">
    <input type="search" name="q" value={search ?? ''} placeholder="Search by email or order id" class="field" />
    <select name="status" class="field">
      <option value="">All statuses</option>
      {(['pending', 'paid', 'fulfilled', 'cancelled', 'refunded'] as const).map((s) => (
        <option value={s} selected={statusFilter === s}>{s}</option>
      ))}
    </select>
    <button type="submit" class="btn btn-ghost py-1.5">Filter</button>
  </form>

  <table class="mt-6 w-full text-sm">
    <thead>
      <tr class="border-b border-border-strong text-left text-xs uppercase tracking-widest text-ink-muted">
        <th class="py-2">Date</th>
        <th class="py-2">Customer</th>
        <th class="py-2">Items</th>
        <th class="py-2">Total</th>
        <th class="py-2">Status</th>
      </tr>
    </thead>
    <tbody>
      {
        orders.map((order) => (
          <tr class="border-b border-border">
            <td class="py-2 text-ink-muted">{new Date(order.createdAt).toLocaleDateString()}</td>
            <td class="py-2">
              <a href={`/admin/orders/${order._id.toString()}`} class="hover:underline">
                {order.customer.email || order._id.toString().slice(-8)}
              </a>
            </td>
            <td class="py-2 text-ink-muted">{order.items.length}</td>
            <td class="py-2">${(order.totalCents / 100).toFixed(2)}</td>
            <td class="py-2 capitalize">{order.status}</td>
          </tr>
        ))
      }
      {orders.length === 0 && (
        <tr>
          <td colspan="5" class="py-4 text-ink-muted">No orders match this filter.</td>
        </tr>
      )}
    </tbody>
  </table>
</AdminLayout>

---
import PhotoCard from './PhotoCard.astro';

export interface GridItem {
  href: string;
  slug: string;
  title: string;
  aspectRatio: number;
  lqip: string;
  webpUrl: string;
  jpegUrl: string;
  photoId: string;
  /** Whether the viewer's session cart already holds this photo — read fresh on every
   *  render, same as the buy panel, so the toggle never opens showing a stale state.
   *  Omitted on exhibition grids, which render no toggle for it to reflect. */
  inCart?: boolean;
  /** The cart line to remove when toggling off. Present exactly when `inCart` is true. */
  lineId?: string;
}

interface Props {
  items: GridItem[];
  /**
   * Whether the tiles are for sale. The homepage strip is an *exhibition* — the work on
   * show, not the shop — so it opts out: a plus button on every frame turns a curated
   * wall into a product listing before the visitor has even seen what the photographs
   * are. Every tile still links through to its own page, where buying is the point and
   * the buy panel is waiting.
   */
  showCart?: boolean;
  addToCartLabel?: string;
  removeFromCartLabel?: string;
}

const { items, showCart = true, addToCartLabel, removeFromCartLabel } = Astro.props;

/*
 * An asymmetric modular grid in the Japanese editorial tradition (see Muji/Casa BRUTUS
 * photo spreads) — a handful of tile shapes on a shared unit grid, mixed in a deliberate
 * rhythm rather than uniform rows or free-flowing masonry, with generous gaps standing in
 * for ma (間), the negative space those layouts lean on.
 *
 * Tailwind's class scanner needs the full class name literally in source to generate its
 * CSS — it can't see through `col-span-${n}` template interpolation — so tile shapes are
 * a lookup of complete, static class strings rather than assembled from numbers.
 */
const TILE_CLASSES = {
  feature: 'col-span-2 row-span-2 md:col-span-3 md:row-span-2',
  wide: 'col-span-2 row-span-1',
  tall: 'col-span-1 row-span-2',
  small: 'col-span-1 row-span-1',
} as const;

type TileType = keyof typeof TILE_CLASSES;

// Cycled by index for a rhythm that reads as curated rather than repetitive: an opening
// feature, small accents, a couple of wide beats, and tall slots that double as the
// natural home for any portrait-oriented photo (see isPortrait below).
const PATTERN: TileType[] = ['feature', 'small', 'small', 'tall', 'small', 'wide', 'small', 'small', 'wide', 'tall', 'small'];

function tileClassFor(item: GridItem, index: number): string {
  const isPortrait = item.aspectRatio < 0.85;
  const type = isPortrait ? 'tall' : PATTERN[index % PATTERN.length];
  return TILE_CLASSES[type];
}
---

<!--
  grid-flow-row-dense packs each tile into the first slot it fits on the shared 2/6-column
  grid, so mixing feature/wide/tall/small shapes never leaves gaps — no JS layout pass or
  measurement needed, same zero-layout-shift property the old flex-based grid had.

  `data-exhibition` is the one hook the wall needs that a single tile can't own: it's what
  global.css keys the lead tile's slow drift off, and it has to be read from the container
  because "the lead tile" is a fact about the grid, not about any photograph in it.
-->
<div
  class="grid grid-cols-2 auto-rows-[clamp(120px,32vw,220px)] grid-flow-row-dense gap-1 md:grid-cols-6 md:auto-rows-[clamp(90px,13vw,170px)] md:gap-2"
  data-exhibition={showCart ? undefined : ''}
>
  {
    items.map((item, i) => (
      <PhotoCard
        href={item.href}
        slug={item.slug}
        title={item.title}
        lqip={item.lqip}
        webpUrl={item.webpUrl}
        jpegUrl={item.jpegUrl}
        tileClass={tileClassFor(item, i)}
        eager={i < 4}
        photoId={item.photoId}
        showCart={showCart}
        inCart={item.inCart ?? false}
        lineId={item.lineId}
        addToCartLabel={addToCartLabel}
        removeFromCartLabel={removeFromCartLabel}
      />
    ))
  }
</div>

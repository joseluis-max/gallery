---
import PhotoCard from './PhotoCard.astro';

export interface GridItem {
  href: string;
  slug: string;
  title: string;
  aspectRatio: number;
  lqip: string;
  webpUrl: string;
  jpegUrl: string;
}

interface Props {
  items: GridItem[];
}

const { items } = Astro.props;

/*
 * An asymmetric modular grid in the Japanese editorial tradition (see Muji/Casa BRUTUS
 * photo spreads) — a handful of tile shapes on a shared unit grid, mixed in a deliberate
 * rhythm rather than uniform rows or free-flowing masonry, with generous gaps standing in
 * for ma (間), the negative space those layouts lean on.
 *
 * Tailwind's class scanner needs the full class name literally in source to generate its
 * CSS — it can't see through `col-span-${n}` template interpolation — so tile shapes are
 * a lookup of complete, static class strings rather than assembled from numbers.
 */
const TILE_CLASSES = {
  feature: 'col-span-2 row-span-2 md:col-span-3 md:row-span-2',
  wide: 'col-span-2 row-span-1',
  tall: 'col-span-1 row-span-2',
  small: 'col-span-1 row-span-1',
} as const;

type TileType = keyof typeof TILE_CLASSES;

// Cycled by index for a rhythm that reads as curated rather than repetitive: an opening
// feature, small accents, a couple of wide beats, and tall slots that double as the
// natural home for any portrait-oriented photo (see isPortrait below).
const PATTERN: TileType[] = ['feature', 'small', 'small', 'tall', 'small', 'wide', 'small', 'small', 'wide', 'tall', 'small'];

function tileClassFor(item: GridItem, index: number): string {
  const isPortrait = item.aspectRatio < 0.85;
  const type = isPortrait ? 'tall' : PATTERN[index % PATTERN.length];
  return TILE_CLASSES[type];
}
---

<!--
  grid-flow-row-dense packs each tile into the first slot it fits on the shared 2/6-column
  grid, so mixing feature/wide/tall/small shapes never leaves gaps — no JS layout pass or
  measurement needed, same zero-layout-shift property the old flex-based grid had.
-->
<div class="grid grid-cols-2 auto-rows-[clamp(120px,32vw,220px)] grid-flow-row-dense gap-1 md:grid-cols-6 md:auto-rows-[clamp(90px,13vw,170px)] md:gap-2">
  {
    items.map((item, i) => (
      <PhotoCard
        href={item.href}
        slug={item.slug}
        title={item.title}
        lqip={item.lqip}
        webpUrl={item.webpUrl}
        jpegUrl={item.jpegUrl}
        tileClass={tileClassFor(item, i)}
        eager={i < 4}
      />
    ))
  }
</div>

<script>
  document.addEventListener('astro:page-load', () => {
    const targets = document.querySelectorAll<HTMLElement>('[data-reveal]:not([data-reveal-bound])');
    if (targets.length === 0) return;

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        }
      },
      { rootMargin: '0px 0px -5% 0px', threshold: 0.05 },
    );

    for (const el of targets) {
      el.dataset.revealBound = 'true';
      observer.observe(el);
    }
  });
</script>

<style>
  [data-reveal] {
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 0.6s ease-out,
      transform 0.6s ease-out;
  }
  [data-reveal].is-visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

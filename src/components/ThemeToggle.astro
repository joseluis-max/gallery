{/*
  Targeted by attribute rather than id, because the header renders one of these in the
  desktop nav and another inside the mobile menu — two elements sharing an id would be
  invalid HTML and only the first would ever get wired up.
*/}
<button
  data-theme-toggle
  type="button"
  aria-label="Toggle color theme"
  class="chip py-1.5 uppercase tracking-widest text-ink-muted transition-colors hover:text-ink"
>
  <span data-theme-label>Theme</span>
</button>

<script>
  // `astro:page-load` fires on the very first load AND after every ClientRouter
  // swap, so this one listener covers both cases without a separate
  // DOMContentLoaded + astro:after-swap pairing.
  document.addEventListener('astro:page-load', () => {
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');
    if (buttons.length === 0) return;

    const syncAll = () => {
      const current = document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
      for (const button of buttons) {
        const label = button.querySelector('[data-theme-label]');
        if (label) label.textContent = current === 'dark' ? 'Dark' : 'Light';
        button.setAttribute('aria-pressed', String(current === 'dark'));
      }
    };
    syncAll();

    for (const button of buttons) {
      if (button.dataset.bound === 'true') continue;
      button.dataset.bound = 'true';
      button.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        localStorage.setItem('theme', next);
        // Every instance, not just the clicked one — the desktop and mobile toggles must
        // not disagree about what the current theme is.
        syncAll();
      });
    }
  });
</script>

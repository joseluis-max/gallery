---
interface Props {
  slug: string;
  title: string;
  webpUrl: string;
  jpegUrl: string;
  aspectRatio: number;
  lqip: string;
}

const { slug, title, webpUrl, jpegUrl, aspectRatio, lqip } = Astro.props;
---

{/*
  The inline aspect-ratio does two jobs: it reserves the right box before the image
  decodes (no layout shift) and it's what the view-transition morph animates against.
  `max-height` + `width: auto` alongside it means a tall portrait shrinks proportionally
  instead of being cropped by the column — which is what happened when the detail page
  became two columns and the image no longer had the full page width to work with.
*/}
<button
  type="button"
  class="group relative mx-auto block w-full cursor-zoom-in overflow-hidden bg-border"
  style={`aspect-ratio: ${aspectRatio}; max-height: 78vh; width: auto;`}
  data-lightbox-trigger
  aria-label={`Enlarge: ${title}`}
>
  <img src={lqip} alt="" aria-hidden="true" class="absolute inset-0 h-full w-full scale-105 object-cover blur-md" />
  <picture>
    <source srcset={webpUrl} type="image/webp" />
    {/*
      `transition:name` must stay exactly `photo-${slug}` — PhotoCard.astro uses the same
      string, and the pair is what morphs a grid tile into this hero. A mismatch degrades
      silently to a crossfade with nothing failing loudly, so don't "tidy" it.
    */}
    <img
      src={jpegUrl}
      alt={title}
      loading="eager"
      decoding="async"
      transition:name={`photo-${slug}`}
      class="relative h-full w-full object-contain"
    />
  </picture>
</button>

<div
  data-lightbox-overlay
  class="fixed inset-0 z-50 hidden items-center justify-center bg-ink/90 p-4 backdrop-blur-sm"
  role="dialog"
  aria-modal="true"
  aria-label={title}
>
  <button type="button" data-lightbox-close aria-label="Close" class="absolute right-4 top-4 text-3xl text-surface">
    &times;
  </button>
  <picture>
    <source srcset={webpUrl} type="image/webp" />
    <img src={jpegUrl} alt={title} class="max-h-[90vh] max-w-[92vw] object-contain" />
  </picture>
</div>

<script>
  // Module scope, deliberately. This bundled module is evaluated once per full page load
  // and is NOT re-evaluated by ClientRouter navigations, so the flag survives exactly as
  // long as the document-level listener below does.
  //
  // Storing it on `document.body` would not work: ClientRouter replaces the <body>
  // element wholesale on every navigation (verified), so a flag parked there resets each
  // time and the guard would silently do nothing — which is precisely the leak this is
  // here to prevent.
  let escapeBound = false;

  document.addEventListener('astro:page-load', () => {
    const trigger = document.querySelector<HTMLButtonElement>('[data-lightbox-trigger]');
    const overlay = document.querySelector<HTMLElement>('[data-lightbox-overlay]');
    const closeBtn = document.querySelector<HTMLButtonElement>('[data-lightbox-close]');
    if (!trigger || !overlay || !closeBtn) return;

    const open = () => {
      overlay.classList.remove('hidden');
      overlay.classList.add('flex');
      document.body.style.overflow = 'hidden';
    };
    const close = () => {
      overlay.classList.add('hidden');
      overlay.classList.remove('flex');
      document.body.style.overflow = '';
    };

    trigger.addEventListener('click', open);
    closeBtn.addEventListener('click', close);
    overlay.addEventListener('click', (e) => {
      if (e.target === overlay) close();
    });

    // The three listeners above are on elements ClientRouter replaces, so they're
    // discarded with the old DOM. This one is on `document`, which survives every
    // navigation — without the guard it stacked up one more Escape handler per page view
    // for the life of the session.
    if (!escapeBound) {
      escapeBound = true;
      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape') return;
        // Re-queried per press rather than captured at bind time: the overlay this
        // closure could have closed over belongs to whichever page happened to load first.
        const current = document.querySelector<HTMLElement>('[data-lightbox-overlay]');
        if (!current || current.classList.contains('hidden')) return;
        current.classList.add('hidden');
        current.classList.remove('flex');
        document.body.style.overflow = '';
      });
    }
  });
</script>

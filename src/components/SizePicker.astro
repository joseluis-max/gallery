---
import type { Dictionary } from '../lib/i18n/es';
import type { Locale } from '../lib/i18n';
import type { SettingsDoc } from '../lib/settings';

interface Props {
  photoId: string;
  aspectRatio: number;
  maxPrintCm: number;
  settings: SettingsDoc;
  digitalPriceCents: number;
  t: Dictionary;
  lang: Locale;
}

const { photoId, aspectRatio, maxPrintCm, settings, digitalPriceCents, t, lang } = Astro.props;

function fits(widthCm: number, heightCm: number): boolean {
  return Math.max(widthCm, heightCm) <= maxPrintCm;
}

const paperEntries = Object.entries(settings.paperStocks);
---

<div
  data-size-picker
  data-photo-id={photoId}
  data-aspect-ratio={aspectRatio}
  data-max-print-cm={maxPrintCm}
  data-tolerance-pct={settings.sizeTolerancePct}
  data-error-messages={JSON.stringify(t.pricing.errors)}
  class="space-y-5"
>
  <div>
    <p class="text-xs uppercase tracking-widest text-ink-muted">{t.pricing.size}</p>
    <div class="mt-2 flex flex-wrap gap-2">
      {
        settings.sizePresets.map((preset) => (
          <button
            type="button"
            data-preset
            data-width={preset.widthCm}
            data-height={preset.heightCm}
            disabled={!fits(preset.widthCm, preset.heightCm)}
            title={!fits(preset.widthCm, preset.heightCm) ? t.pricing.errors.EXCEEDS_MAX_PRINT_CM : undefined}
            class="rounded-full border border-border px-3 py-1.5 text-sm disabled:cursor-not-allowed disabled:opacity-30 aria-pressed:border-ink aria-pressed:bg-ink aria-pressed:text-surface"
          >
            {preset.widthCm}×{preset.heightCm}
          </button>
        ))
      }
      <button
        type="button"
        data-preset-custom
        class="rounded-full border border-border px-3 py-1.5 text-sm aria-pressed:border-ink aria-pressed:bg-ink aria-pressed:text-surface"
      >
        {t.pricing.custom}
      </button>
    </div>
  </div>

  <div data-custom-size hidden class="flex gap-3">
    <label class="text-sm">
      {t.pricing.widthCm}
      <input type="number" data-width-input min="1" step="0.5" class="mt-1 block w-24 border border-border bg-transparent px-2 py-1" />
    </label>
    <label class="text-sm">
      {t.pricing.heightCm}
      <input type="number" data-height-input min="1" step="0.5" class="mt-1 block w-24 border border-border bg-transparent px-2 py-1" />
    </label>
  </div>

  <label class="block text-sm">
    {t.pricing.paper}
    <select data-paper-select class="mt-1 block w-full border border-border bg-transparent px-2 py-1.5">
      {paperEntries.map(([key, stock]) => <option value={key}>{stock.label[lang]}</option>)}
    </select>
  </label>

  <label class="block text-sm">
    {t.pricing.qty}
    <input
      type="number"
      data-qty-input
      value="1"
      min="1"
      max="50"
      class="mt-1 block w-20 border border-border bg-transparent px-2 py-1.5"
    />
  </label>

  <div data-crop-choice hidden class="border border-border p-3 text-sm">
    <p class="text-ink-muted">{t.pricing.aspectMismatchNotice}</p>
    <label class="mt-2 flex items-center gap-2">
      <input type="radio" name="crop-choice" value="crop" /> {t.pricing.cropOption}
    </label>
    <label class="mt-1 flex items-center gap-2">
      <input type="radio" name="crop-choice" value="border" /> {t.pricing.borderOption}
    </label>
  </div>

  <div class="flex items-center justify-between border-t border-border pt-4">
    <span data-quote-price class="font-display text-xl">&nbsp;</span>
    <button
      type="button"
      data-add-to-cart
      disabled
      class="rounded-full bg-ink px-5 py-2 text-sm uppercase tracking-widest text-surface disabled:opacity-40"
    >
      {t.detail.buyPrint}
    </button>
  </div>
  <p data-quote-error hidden class="text-sm text-accent"></p>

  <div class="border-t border-border pt-4">
    <button type="button" data-buy-digital class="w-full rounded-full border border-ink px-5 py-2 text-sm uppercase tracking-widest">
      {t.detail.buyDigital} — ${(digitalPriceCents / 100).toFixed(2)}
    </button>
  </div>
</div>

<script>
  import { actions } from 'astro:actions';

  document.addEventListener('astro:page-load', () => {
    const root = document.querySelector<HTMLElement>('[data-size-picker]');
    if (!root || root.dataset.bound === 'true') return;
    root.dataset.bound = 'true';

    const photoId = root.dataset.photoId!;
    const aspectRatio = Number(root.dataset.aspectRatio);
    const tolerancePct = Number(root.dataset.tolerancePct);
    const errorMessages: Record<string, string> = JSON.parse(root.dataset.errorMessages || '{}');

    const presetButtons = root.querySelectorAll<HTMLButtonElement>('[data-preset]');
    const customButton = root.querySelector<HTMLButtonElement>('[data-preset-custom]')!;
    const customSizeBox = root.querySelector<HTMLElement>('[data-custom-size]')!;
    const widthInput = root.querySelector<HTMLInputElement>('[data-width-input]')!;
    const heightInput = root.querySelector<HTMLInputElement>('[data-height-input]')!;
    const paperSelect = root.querySelector<HTMLSelectElement>('[data-paper-select]')!;
    const qtyInput = root.querySelector<HTMLInputElement>('[data-qty-input]')!;
    const cropChoice = root.querySelector<HTMLElement>('[data-crop-choice]')!;
    const cropRadios = root.querySelectorAll<HTMLInputElement>('input[name="crop-choice"]');
    const quotePriceEl = root.querySelector<HTMLElement>('[data-quote-price]')!;
    const quoteErrorEl = root.querySelector<HTMLElement>('[data-quote-error]')!;
    const addToCartBtn = root.querySelector<HTMLButtonElement>('[data-add-to-cart]')!;

    let selectedWidth: number | null = null;
    let selectedHeight: number | null = null;
    let requestSeq = 0;

    function selectPreset(button: HTMLButtonElement) {
      for (const b of presetButtons) b.removeAttribute('aria-pressed');
      customButton.removeAttribute('aria-pressed');
      button.setAttribute('aria-pressed', 'true');
      customSizeBox.hidden = true;
      selectedWidth = Number(button.dataset.width);
      selectedHeight = Number(button.dataset.height);
      requestQuote();
    }

    presetButtons.forEach((button) => {
      if (!button.disabled) button.addEventListener('click', () => selectPreset(button));
    });

    customButton.addEventListener('click', () => {
      for (const b of presetButtons) b.removeAttribute('aria-pressed');
      customButton.setAttribute('aria-pressed', 'true');
      customSizeBox.hidden = false;
      syncCustomSize();
    });

    function syncCustomSize() {
      const w = Number(widthInput.value);
      const h = Number(heightInput.value);
      if (w > 0 && h > 0) {
        selectedWidth = w;
        selectedHeight = h;
        requestQuote();
      }
    }
    widthInput.addEventListener('input', syncCustomSize);
    heightInput.addEventListener('input', syncCustomSize);
    paperSelect.addEventListener('change', requestQuote);
    qtyInput.addEventListener('input', requestQuote);
    cropRadios.forEach((radio) => radio.addEventListener('change', requestQuote));

    function currentCrop(): 'fit' | 'crop' | 'border' {
      const checked = root!.querySelector<HTMLInputElement>('input[name="crop-choice"]:checked');
      return (checked?.value as 'crop' | 'border' | undefined) ?? 'fit';
    }

    function showAspectMismatch(show: boolean) {
      cropChoice.hidden = !show;
    }

    async function requestQuote() {
      if (selectedWidth === null || selectedHeight === null) return;

      const deviation = Math.abs(selectedWidth / selectedHeight - aspectRatio) / aspectRatio;
      const needsCropChoice = deviation > tolerancePct;
      showAspectMismatch(needsCropChoice);

      const seq = ++requestSeq;
      quoteErrorEl.hidden = true;
      addToCartBtn.disabled = true;

      const { data, error } = await actions.quotePrice({
        photoId,
        widthCm: selectedWidth,
        heightCm: selectedHeight,
        paper: paperSelect.value,
        qty: Number(qtyInput.value) || 1,
        crop: needsCropChoice ? currentCrop() : 'fit',
      });
      if (seq !== requestSeq) return; // a newer request superseded this one

      if (error) {
        quotePriceEl.textContent = '';
        // The action re-throws PricingError as an ActionError whose `message` is the
        // PricingErrorCode (e.g. "EXCEEDS_MAX_PRINT_CM") — look up the localized copy,
        // falling back to the raw code for anything unmapped (e.g. a NOT_FOUND).
        quoteErrorEl.textContent = errorMessages[error.message] ?? error.message;
        quoteErrorEl.hidden = false;
        addToCartBtn.disabled = true;
        return;
      }

      quotePriceEl.textContent = `$${(data.totalCents / 100).toFixed(2)}`;
      addToCartBtn.disabled = false;
    }

    function currentLang(): 'es' | 'en' {
      return location.pathname.startsWith('/en/') ? 'en' : 'es';
    }

    addToCartBtn.addEventListener('click', async () => {
      if (selectedWidth === null || selectedHeight === null) return;
      addToCartBtn.disabled = true;
      const { error } = await actions.addToCart({
        photoId,
        type: 'print',
        widthCm: selectedWidth,
        heightCm: selectedHeight,
        paper: paperSelect.value,
        qty: Number(qtyInput.value) || 1,
        crop: currentCrop(),
      });
      if (error) {
        quoteErrorEl.textContent = errorMessages[error.message] ?? error.message;
        quoteErrorEl.hidden = false;
        addToCartBtn.disabled = false;
        return;
      }
      window.location.href = `/${currentLang()}/cart`;
    });

    const buyDigitalBtn = root.querySelector<HTMLButtonElement>('[data-buy-digital]')!;
    buyDigitalBtn.addEventListener('click', async () => {
      buyDigitalBtn.disabled = true;
      const { error } = await actions.addToCart({ photoId, type: 'digital', qty: 1 });
      if (error) {
        quoteErrorEl.textContent = errorMessages[error.message] ?? error.message;
        quoteErrorEl.hidden = false;
        buyDigitalBtn.disabled = false;
        return;
      }
      window.location.href = `/${currentLang()}/cart`;
    });
  });
</script>

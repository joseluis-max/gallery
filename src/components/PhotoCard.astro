---
interface Props {
  href: string;
  slug: string;
  title: string;
  lqip: string;
  webpUrl: string;
  jpegUrl: string;
  /** Grid placement utility classes (col/row span) for this card's slot in the mosaic —
   *  computed by the grid, not this component, so it stays layout-agnostic. */
  tileClass: string;
  eager?: boolean;
}

const { href, slug, title, lqip, webpUrl, jpegUrl, tileClass, eager = false } = Astro.props;
---

<a href={href} class={`group relative block overflow-hidden bg-border ${tileClass}`} data-reveal>
  <img
    src={lqip}
    alt=""
    aria-hidden="true"
    class="absolute inset-0 h-full w-full object-cover scale-105 blur-md"
    loading="eager"
  />
  <picture>
    <source srcset={webpUrl} type="image/webp" />
    <img
      src={jpegUrl}
      alt={title}
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      transition:name={`photo-${slug}`}
      class="relative h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.02]"
    />
  </picture>
</a>

---
import type { Dictionary } from '../lib/i18n/es';
import type { Locale } from '../lib/i18n';

interface Props {
  photoId: string;
  digitalPriceCents: number;
  t: Dictionary;
  lang: Locale;
  /** Undefined for a signed-out visitor. Read fresh from the database on every render —
   *  never from the session, which is a sign-in snapshot that would go stale the moment a
   *  credit is spent in another tab. */
  freeDownloadsRemaining?: number;
  /** True when this account has already claimed this photograph — it can be downloaded
   *  again without spending a second credit. */
  alreadyClaimed?: boolean;
  /** Set when the viewer already bought or claimed this photograph, so the panel can
   *  offer a fresh download link instead of selling it twice. */
  ownedOrderId?: string;
}

const { photoId, digitalPriceCents, t, lang, freeDownloadsRemaining, alreadyClaimed = false, ownedOrderId } = Astro.props;

const signedIn = freeDownloadsRemaining !== undefined;
const hasCredits = (freeDownloadsRemaining ?? 0) > 0;
const owned = alreadyClaimed || Boolean(ownedOrderId);

// Signing in must return the visitor to this photograph, not dump them on the account
// page — login.astro already runs `?next=` through safeRedirectTarget.
const signInHref = `/${lang}/account/login?next=${encodeURIComponent(Astro.url.pathname)}`;
---

{/*
  Replaces SizePicker.astro, which was ~90% print controls. A digital download has one
  price and no options, so the whole live-quote machinery went with them; what's left is
  the free-vs-paid decision.
*/}
<div
  data-buy-panel
  data-photo-id={photoId}
  data-lang={lang}
  data-order-id={ownedOrderId}
  data-owned={String(owned)}
  class="panel space-y-3 p-4"
>
  {!owned && <p class="font-display text-3xl">${(digitalPriceCents / 100).toFixed(2)}</p>}

  {
    owned ? (
      <>
        <p class="font-display text-xl">{t.detail.alreadyYours}</p>
        <button type="button" data-redownload class="btn btn-primary w-full py-3">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 4v10" />
            <path d="M8 11l4 4 4-4" />
            <path d="M5 19h14" />
          </svg>
          {t.detail.downloadAgain}
        </button>
      </>
    ) : signedIn && hasCredits ? (
      <>
        {/* Accent-filled, not ink: this is the generous option sitting above a paid one,
            and the two must not look like the same button twice. */}
        <button type="button" data-claim-free class="btn btn-accent w-full py-3">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 3l2.4 5.3 5.6.6-4.2 3.9 1.2 5.7L12 15.8 6.9 18.5l1.2-5.7L4 8.9l5.6-.6z" />
          </svg>
          {t.detail.downloadFree.replace('{remaining}', String(freeDownloadsRemaining))}
        </button>
        <button type="button" data-add-to-cart class="btn btn-ghost w-full py-3">
          {t.detail.buyDigital}
        </button>
      </>
    ) : (
      <>
        <button type="button" data-add-to-cart class="btn btn-primary w-full py-3">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 4h2l2.4 10.4a2 2 0 0 0 2 1.6h7.7a2 2 0 0 0 2-1.5L21 8H6" />
            <circle cx="10" cy="20" r="1" />
            <circle cx="18" cy="20" r="1" />
          </svg>
          {t.detail.buyDigital}
        </button>
        {signedIn ? (
          <p class="text-sm text-ink-muted">{t.detail.freeUsedUp}</p>
        ) : (
          <a
            href={signInHref}
            class="flex items-start gap-2 rounded-md bg-accent-wash p-3 text-sm transition-colors hover:text-accent"
          >
            <svg class="mt-0.5 h-4 w-4 shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 3l2.4 5.3 5.6.6-4.2 3.9 1.2 5.7L12 15.8 6.9 18.5l1.2-5.7L4 8.9l5.6-.6z" />
            </svg>
            <span>{t.detail.freeSignedOut} &rarr;</span>
          </a>
        )}
      </>
    )
  }

  {/* What you actually receive, stated where the decision is made rather than discovered
      after paying. */}
  <ul class="space-y-1.5 border-t border-border pt-3 text-xs text-ink-muted">
    <li class="flex items-center gap-2">
      <svg class="h-3.5 w-3.5 shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3.5" y="5" width="17" height="14" rx="2" />
        <path d="M4 17l5-4 4 3 3-2 4 3" />
      </svg>
      {t.home.trustOriginal}
    </li>
    <li class="flex items-center gap-2">
      <svg class="h-3.5 w-3.5 shrink-0 text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 4v10" />
        <path d="M8 11l4 4 4-4" />
        <path d="M5 19h14" />
      </svg>
      {t.home.trustInstant}
    </li>
  </ul>

  <p data-buy-error hidden class="text-sm text-accent"></p>
</div>

<script>
  import { actions } from 'astro:actions';

  document.addEventListener('astro:page-load', () => {
    const root = document.querySelector<HTMLElement>('[data-buy-panel]');
    if (!root || root.dataset.bound === 'true') return;
    root.dataset.bound = 'true';

    const photoId = root.dataset.photoId!;
    const lang = root.dataset.lang!;
    const errorEl = root.querySelector<HTMLElement>('[data-buy-error]')!;

    function fail(button: HTMLButtonElement, message: string) {
      errorEl.textContent = message;
      errorEl.hidden = false;
      button.disabled = false;
    }

    /**
     * The action returns `/api/download/<token>`, which 302s to a short-lived presigned
     * URL. Clicking a real anchor keeps the visitor on the page and lets the browser
     * handle it as a download; navigating the tab there instead would leave them staring
     * at a redirect.
     */
    function startDownload(url: string) {
      const link = document.createElement('a');
      link.href = url;
      link.download = '';
      document.body.appendChild(link);
      link.click();
      link.remove();
    }

    root.querySelector<HTMLButtonElement>('[data-add-to-cart]')?.addEventListener('click', async (event) => {
      const button = event.currentTarget as HTMLButtonElement;
      errorEl.hidden = true;
      button.disabled = true;

      const { error } = await actions.addToCart({ photoId });
      if (error) return fail(button, error.message);

      window.location.href = `/${lang}/cart`;
    });

    root.querySelector<HTMLButtonElement>('[data-claim-free]')?.addEventListener('click', async (event) => {
      const button = event.currentTarget as HTMLButtonElement;
      errorEl.hidden = true;
      button.disabled = true;

      const { data, error } = await actions.downloads.claimFree({ photoId });
      if (error || !data) return fail(button, error?.message ?? 'CLAIM_FAILED');

      startDownload(data.url);
      // Reload so the panel re-renders from the server with the new balance — the count
      // lives in the database, not in this page's state.
      window.location.reload();
    });

    root.querySelector<HTMLButtonElement>('[data-redownload]')?.addEventListener('click', async (event) => {
      const button = event.currentTarget as HTMLButtonElement;
      errorEl.hidden = true;
      button.disabled = true;

      const orderId = root.dataset.orderId;
      const { data, error } = orderId
        ? await actions.downloads.reissue({ orderId, photoId })
        : await actions.downloads.claimFree({ photoId });

      if (error || !data) return fail(button, error?.message ?? 'DOWNLOAD_FAILED');

      startDownload(data.url);
      button.disabled = false;
    });
  });
</script>

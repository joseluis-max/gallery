---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;

const NAV = [
  { href: '/admin', label: 'Dashboard' },
  { href: '/admin/analytics', label: 'Analytics' },
  { href: '/admin/upload', label: 'Upload' },
  { href: '/admin/photos', label: 'Photos' },
  { href: '/admin/orders', label: 'Orders' },
  { href: '/admin/customers', label: 'Customers' },
  { href: '/admin/downloads', label: 'Downloads' },
  { href: '/admin/activity', label: 'Activity' },
  { href: '/admin/pricing', label: 'Pricing' },
];

const currentPath = Astro.url.pathname;
const sessionUser = await Astro.session?.get('user');
---

<!doctype html>
<html lang="en" data-theme="">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title} — Admin</title>
    <script is:inline>
      (function () {
        var stored = localStorage.getItem('theme');
        var theme = stored || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body class="min-h-screen bg-surface text-ink font-body antialiased">
    <div class="grid min-h-screen grid-cols-[220px_1fr]">
      <aside class="border-r border-border px-5 py-6">
        <a href="/admin" class="font-display text-lg">José Valdiviezo</a>
        <p class="mt-1 text-xs uppercase tracking-widest text-ink-muted">Admin</p>
        <nav class="mt-8 flex flex-col gap-1 text-sm">
          {
            NAV.map((item) => (
              <a
                href={item.href}
                class={`rounded px-2 py-1.5 ${currentPath === item.href || (item.href !== '/admin' && currentPath.startsWith(item.href)) ? 'bg-ink text-surface' : 'text-ink-muted hover:text-ink'}`}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
        <div class="mt-8 text-xs text-ink-muted">
          {sessionUser && <p class="truncate" title={sessionUser.email}>{sessionUser.email}</p>}
          <button type="button" data-admin-logout class="mt-2 uppercase tracking-widest hover:text-accent">
            Log out
          </button>
        </div>
      </aside>
      <main class="overflow-x-auto px-8 py-8">
        <slot />
      </main>
    </div>

    <script>
      import { actions } from 'astro:actions';
      document.querySelector('[data-admin-logout]')?.addEventListener('click', async () => {
        await actions.auth.logout({});
        window.location.href = '/admin';
      });
    </script>
  </body>
</html>

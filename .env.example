# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit real credentials.

# --- Site ---
# Public base URL of the deployed site (used for absolute links, hreflang, sitemap, OG tags).
PUBLIC_SITE_URL=http://localhost:4321

# --- MongoDB Atlas ---
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net
MONGODB_DB_NAME=valdiviezo

# --- Cloudflare R2 ---
# Account-level API token scoped to R2, NOT a global API key.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Bucket names — the "originals" bucket must have NO public access / NO CDN binding.
R2_BUCKET_ORIGINALS=originals
R2_BUCKET_PUBLIC=public
# Public base URL the "public" bucket is served from (custom domain or r2.dev subdomain).
R2_PUBLIC_BASE_URL=https://cdn.example.com

# --- Stripe ---
# Test-mode keys while developing: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen --forward-to localhost:4321/api/stripe-webhook` (test) or the
# webhook endpoint's signing secret in the Stripe dashboard (production).
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Admin ---
# Generate with: pnpm hash-admin-password
ADMIN_PASSWORD_HASH=

# --- Downloads ---
DOWNLOAD_TOKEN_TTL_DAYS=7
DOWNLOAD_TOKEN_MAX_USES=5

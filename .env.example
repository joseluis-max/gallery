# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit real credentials.

# --- Site ---
# Public base URL of the deployed site (used for absolute links, hreflang, sitemap, OG tags).
PUBLIC_SITE_URL=http://localhost:4321

# --- MongoDB Atlas ---
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net
MONGODB_DB_NAME=valdiviezo

# --- Storage ---
# Where image bytes live: gcs | local. Both implement the same adapter, so switching is
# this one variable.
#   gcs   — Google Cloud Storage (production)
#   local — disk under LOCAL_STORAGE_DIR, served by the app. Development only: no CDN,
#           and originals stream through the app server on download.
STORAGE_DRIVER=gcs
LOCAL_STORAGE_DIR=tmp/local-storage

# --- Google Cloud Storage (STORAGE_DRIVER=gcs) ---
# ONE bucket, split by prefix: everything under GCS_PUBLIC_PREFIX is world-readable,
# everything else — including GCS_ORIGINALS_PREFIX — must NOT be. That means the bucket's
# only public IAM binding must be conditional on the public prefix; see the README.
# Credentials are HMAC keys from Cloud Storage → Settings → Interoperability — a
# service-account JSON key will NOT work, because presigned browser uploads go through
# the S3-compatible XML API.
GCS_ACCESS_KEY_ID=
GCS_SECRET_ACCESS_KEY=
GCS_BUCKET=
GCS_ORIGINALS_PREFIX=originals
GCS_PUBLIC_PREFIX=public
# Optional — defaults to https://storage.googleapis.com/<GCS_BUCKET>. Set it to a
# Cloud CDN or custom domain in production.
GCS_PUBLIC_BASE_URL=

# --- Stripe ---
# Test-mode keys while developing: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
# From `stripe listen --forward-to localhost:4321/api/stripe-webhook` (test) or the
# webhook endpoint's signing secret in the Stripe dashboard (production).
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Admin ---
# Admin access is an account in the `users` collection, not an env var. Create the first
# one with: pnpm create-admin <email> <password> [name]
# (Older deployments had ADMIN_PASSWORD_HASH here; it is no longer read.)

# --- Downloads ---
DOWNLOAD_TOKEN_TTL_DAYS=7
DOWNLOAD_TOKEN_MAX_USES=5

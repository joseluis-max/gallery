# Never send secrets to the build context — Cloud Build uploads this directory, and the
# image would carry them.
.env
.env.*
!.env.example

node_modules
dist
.astro
.git
.claude

# Local artefacts and binaries: seed photos are git-ignored originals, tmp holds
# scratch output, public/local-public is the local storage driver's output.
tmp
public/local-public
seed/photos

*.log
.DS_Store
